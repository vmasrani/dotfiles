#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer>=0.12.0", "loguru>=0.7.0", "rich>=13.7.1"]
# ///
"""Bootstrap-export live iTerm2 prefs into the repo folder iTerm2 loads from."""

import plistlib
import subprocess
from pathlib import Path

import typer
from loguru import logger

DOMAIN = "com.googlecode.iterm2"
DROP_PREFIXES = ("NoSync", "NS", "SU", "UK")
DROP_KEYS = {"PrefsCustomFolder", "LoadPrefsFromCustomFolder"}
DEFAULT_OUT = Path(__file__).resolve().parent / f"{DOMAIN}.plist"


def export_domain() -> dict:
    result = subprocess.run(
        ["defaults", "export", DOMAIN, "-"], capture_output=True, check=False
    )
    if result.returncode != 0 or not result.stdout.strip():
        raise SystemExit(
            f"defaults export {DOMAIN} failed (rc={result.returncode}): "
            f"{result.stderr.decode().strip() or 'empty output'}. Has iTerm2 ever run on this machine?"
        )
    prefs = plistlib.loads(result.stdout)
    if not prefs:
        raise SystemExit(f"domain {DOMAIN} exported empty; nothing to write")
    return prefs


def keep(key: str) -> bool:
    return key not in DROP_KEYS and not key.startswith(DROP_PREFIXES)


def main(out: Path = typer.Option(DEFAULT_OUT, help="Destination plist")) -> None:
    prefs = {k: v for k, v in export_domain().items() if keep(k)}
    if not prefs:
        raise SystemExit("all keys filtered out; refusing to write empty plist")
    out.write_bytes(plistlib.dumps(prefs, fmt=plistlib.FMT_XML, sort_keys=True))
    logger.success(f"wrote {len(prefs)} keys, {out.stat().st_size} bytes -> {out}")


if __name__ == "__main__":
    typer.run(main)
