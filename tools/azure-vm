#!/usr/bin/env bash
# Azure VM Archive/Restore Tool
# Implementation of @parot-stats/azureplan.md utilizing az CLI and gum UI

set -eo pipefail

source "${HOME}/dotfiles/shell/gum_utils.sh" 2>/dev/null || true

# Error handler for loud failures
error_handler() {
    local exit_code=$?
    local line_num=$1
    local command="${BASH_COMMAND}"
    echo "" >&2
    gum_error "FATAL ERROR (exit code: $exit_code) on line $line_num: '$command' failed."
    exit $exit_code
}
trap 'error_handler $LINENO' ERR

# Config variables
RG="${AZURE_VM_RG:-mygroup}"
# Use ~/.azure-vm/manifests for manifest storage
MANIFEST_DIR="${HOME}/.azure-vm/manifests"
mkdir -p "$MANIFEST_DIR"

command="$1"
vm_name="$2"

if [[ -z "$command" || -z "$vm_name" ]]; then
    echo "Usage: azure-vm <archive|restore|status|verify> <vm-name>"
    exit 1
fi

manifest_file="${MANIFEST_DIR}/${vm_name}.json"

ensure_az_login() {
    if ! az account show &>/dev/null; then
        gum_error "You are not logged into Azure. Run 'az login' first."
        exit 1
    fi
}

remove_stale_ssh_host_key() {
    local public_ips
    public_ips=$(az vm show -d -g "$RG" -n "$vm_name" --query 'publicIps' -o tsv 2>/dev/null || true)

    if [[ -z "$public_ips" ]]; then
        gum_dim "No public IP found; SSH host key was not changed."
        return
    fi

    local public_ip
    local old_ifs="$IFS"
    IFS=','
    for public_ip in $public_ips; do
        public_ip="${public_ip//[[:space:]]/}"
        [[ -z "$public_ip" ]] && continue
        ssh-keygen -R "$public_ip" >/dev/null 2>&1 || true
        gum_success "Removed any stale SSH host key for $public_ip."
    done
    IFS="$old_ifs"
}

# Data disks are attached AFTER `az vm create`, so the VM has already booted
# without them. Any /etc/fstab entry for a data disk is therefore skipped at
# boot -- silently, if it is marked `nofail` -- and systemd never revisits it
# once local-fs.target is reached. Re-run mount now that the disks are present.
# Uses run-command (via the Azure agent) rather than SSH so this needs no key,
# user, or ssh_config assumptions.
mount_restored_data_disks() {
    local disk_count="$1"
    if [[ "$disk_count" -eq 0 ]]; then
        return 0
    fi

    local remote_script
    remote_script=$(cat <<'REMOTE'
systemctl daemon-reload
mount -a
lsblk -rno NAME,TYPE,FSTYPE,MOUNTPOINT | while read -r name type fstype mnt; do
  case "$type" in disk|part) ;; *) continue ;; esac
  [ -z "$fstype" ] && continue
  case "$fstype" in swap|squashfs) continue ;; esac
  [ -n "$mnt" ] && continue
  echo "UNMOUNTED $name ($fstype)"
done
REMOTE
)

    gum_dim "Mounting restored data disks via the VM agent (takes ~30s)..."

    # The agent may not be ready immediately after boot; retry before giving up.
    local attempt=1
    local max_attempts=3
    local output=""
    local rc=0
    while (( attempt <= max_attempts )); do
        output=$(az vm run-command invoke -g "$RG" -n "$vm_name" \
            --command-id RunShellScript --scripts "$remote_script" \
            --query "value[0].message" -o tsv 2>&1) && rc=0 && break
        rc=1
        if (( attempt < max_attempts )); then
            gum_dim "VM agent not ready yet; retrying ($attempt/$max_attempts)..."
            sleep 20
        fi
        attempt=$((attempt+1))
    done

    if [[ "$rc" -ne 0 ]]; then
        gum_error "Could not mount data disks: the VM agent did not respond after $max_attempts attempts."
        gum_error "The disks ARE attached. Mount them by hand: ssh into $vm_name and run 'sudo mount -a'."
        exit 1
    fi

    local unmounted
    unmounted=$(printf '%s\n' "$output" | grep '^UNMOUNTED ' || true)
    if [[ -n "$unmounted" ]]; then
        gum_warning "Attached but NOT mounted -- no matching /etc/fstab entry:"
        printf '%s\n' "$unmounted" | sed 's/^UNMOUNTED /  \/dev\//'
        gum_warning "Add an fstab entry (LABEL=... is safest) or mount these by hand."
    else
        gum_success "Data disks mounted."
    fi
}

# --- Cost estimation --------------------------------------------------------
# Pulled live from the public Azure Retail Prices API (no auth needed) so
# figures track actual VM size / disk size / region instead of a fixed
# placeholder number. Azure rate-limits this API to ~10 req/min -- keep calls
# to a minimum per status check.

fetch_retail_prices() {
    local filter="$1"
    local encoded
    encoded=$(jq -nr --arg f "$filter" '$f | @uri')
    curl -sf "https://prices.azure.com/api/retail/prices?\$filter=${encoded}"
}

get_vm_hourly_price() {
    local vm_size="$1" region="$2" priority="$3"
    local size_name="${vm_size#Standard_}"
    [[ "$priority" == "Spot" ]] && size_name="${size_name} Spot"
    local filter="serviceName eq 'Virtual Machines' and armRegionName eq '${region}' and armSkuName eq '${vm_size}' and priceType eq 'Consumption'"
    fetch_retail_prices "$filter" | jq -r --arg sku "$size_name" \
        '[.Items[] | select(.type=="Consumption" and .skuName==$sku and (.productName|test("Windows")|not))][0].retailPrice // empty'
}

get_snapshot_price_per_gb() {
    local region="$1"
    local filter="serviceName eq 'Storage' and armRegionName eq '${region}' and skuName eq 'Snapshots LRS'"
    fetch_retail_prices "$filter" | jq -r \
        '[.Items[] | select(.type=="Consumption" and .meterName=="LRS Snapshots" and (.productName|contains("Standard HDD")))][0].retailPrice // empty'
}

# Azure managed disks are billed at fixed tiers keyed off provisioned size
# (P1..P80 Premium, E1..E80 StandardSSD, S1..S80 Standard HDD), not per-GB.
disk_tier_for_gb() {
    local gb="$1"
    local sizes=(4 8 16 32 64 128 256 512 1024 2048 4096 8192 16384 32767)
    local tiers=(1 2 3 4 6 10 15 20 30 40 50 60 70 80)
    local i
    for i in "${!sizes[@]}"; do
        if (( gb <= sizes[i] )); then
            echo "${tiers[i]}"
            return 0
        fi
    done
    echo "${tiers[-1]}"
}

# PremiumV2_LRS/UltraSSD_LRS bill per-IOPS/throughput, not by tier -- echo
# nothing for those so the caller can report them as "not priced" rather
# than fabricate a number.
disk_sku_family() {
    case "$1" in
        Premium_LRS|Premium_ZRS) echo "P" ;;
        StandardSSD_LRS|StandardSSD_ZRS) echo "E" ;;
        Standard_LRS) echo "S" ;;
        *) echo "" ;;
    esac
}

# PremiumV2_LRS/UltraSSD_LRS disks carry custom IOPS/throughput on top of
# the SKU -- `az disk create --source <snapshot>` recreates the disk at the
# SKU's free baseline and silently drops any manual bump. Echoes
# "<iops>\t<mbps>" for those two SKUs, empty otherwise, so archive can save
# it and restore can reapply it explicitly instead of losing it.
disk_perf_tsv() {
    local disk_id="$1"
    local sku
    sku=$(az disk show --ids "$disk_id" --query "sku.name" -o tsv)
    case "$sku" in
        PremiumV2_LRS|UltraSSD_LRS)
            az disk show --ids "$disk_id" --query "[diskIopsReadWrite, diskMbpsReadWrite]" -o tsv ;;
        *)
            echo "" ;;
    esac
}

get_disk_monthly_price() {
    local family="$1" tier="$2" region="$3"
    local tier_name="${family}${tier} LRS"
    local filter="serviceName eq 'Storage' and armRegionName eq '${region}' and skuName eq '${tier_name}'"
    fetch_retail_prices "$filter" | jq -r --arg meter "${tier_name} Disk" \
        '[.Items[] | select(.type=="Consumption" and .meterName==$meter and (.productName|contains("Managed Disks")))][0].retailPrice // empty'
}

# Sums live disk sizes/skus for a running VM into a monthly disk cost, and
# (size-only, sku-agnostic) the equivalent archived-snapshot storage cost.
# Echoes: "<disk_monthly> <total_gb> <unpriced_disk_count>"
sum_disk_costs() {
    local vm_json="$1" region="$2"
    local disk_ids
    mapfile -t disk_ids < <(jq -r '[.storageProfile.osDisk.managedDisk.id] + [.storageProfile.dataDisks[].managedDisk.id] | .[]' <<<"$vm_json")

    local disk_total=0 total_gb=0 unpriced=0
    local disk_id sku size family tier price
    for disk_id in "${disk_ids[@]}"; do
        sku=$(az disk show --ids "$disk_id" --query "sku.name" -o tsv)
        size=$(az disk show --ids "$disk_id" --query "diskSizeGB" -o tsv)
        total_gb=$((total_gb + size))
        family=$(disk_sku_family "$sku")
        if [[ -z "$family" ]]; then
            unpriced=$((unpriced + 1))
            continue
        fi
        tier=$(disk_tier_for_gb "$size")
        price=$(get_disk_monthly_price "$family" "$tier" "$region")
        if [[ -z "$price" ]]; then
            unpriced=$((unpriced + 1))
            continue
        fi
        disk_total=$(jq -n --argjson a "$disk_total" --argjson b "$price" '$a + $b')
    done
    echo "$disk_total $total_gb $unpriced"
}

print_running_estimate() {
    local vm_json
    vm_json=$(az vm show -n "$vm_name" -g "$RG" -o json)

    local region vm_size priority
    region=$(jq -r '.location' <<<"$vm_json")
    vm_size=$(jq -r '.hardwareProfile.vmSize' <<<"$vm_json")
    priority=$(jq -r '.priority // "Regular"' <<<"$vm_json")
    [[ "$priority" == "Spot" ]] || priority="Regular"

    local vm_hourly
    vm_hourly=$(get_vm_hourly_price "$vm_size" "$region" "$priority")
    if [[ -z "$vm_hourly" ]]; then
        gum_warning "No retail price found for $vm_size ($priority) in $region; compute cost omitted below."
        vm_hourly=0
    fi
    local vm_monthly
    vm_monthly=$(jq -n --argjson h "$vm_hourly" '($h * 730 * 100 | round) / 100')

    read -r disk_monthly total_gb unpriced < <(sum_disk_costs "$vm_json" "$region")

    local total
    total=$(jq -n --argjson a "$vm_monthly" --argjson b "$disk_monthly" '(($a + $b) * 100 | round) / 100')

    echo "VM: $vm_size ($priority) -- \$$(printf '%.2f' "$vm_monthly")/mo compute"
    if (( unpriced > 0 )); then
        echo "Disks: $total_gb GB -- \$$(printf '%.2f' "$disk_monthly")/mo ($unpriced disk(s) not priced: PremiumV2/Ultra, check portal)"
    else
        echo "Disks: $total_gb GB -- \$$(printf '%.2f' "$disk_monthly")/mo"
    fi
    echo "Monthly estimate: \$$(printf '%.2f' "$total")"

    local snap_price_per_gb
    snap_price_per_gb=$(get_snapshot_price_per_gb "$region")
    if [[ -n "$snap_price_per_gb" ]]; then
        local archived_total savings
        archived_total=$(jq -n --argjson g "$total_gb" --argjson p "$snap_price_per_gb" '(($g * $p) * 100 | round) / 100')
        savings=$(jq -n --argjson a "$total" --argjson b "$archived_total" '(($a - $b) * 100 | round) / 100')
        echo "Potential archived cost: \$$(printf '%.2f' "$archived_total")"
        echo "Potential savings: \$$(printf '%.2f' "$savings")/month"
    fi
}

print_archived_estimate() {
    local region
    region=$(jq -r '.location' "$manifest_file")

    local snapshot_names
    mapfile -t snapshot_names < <(jq -r '[.archive.osDiskSnapshot] + (.archive.dataDiskSnapshots // []) | .[] | select(. != null)' "$manifest_file")

    local total_gb=0 name size
    for name in "${snapshot_names[@]}"; do
        size=$(az snapshot show -n "$name" -g "$RG" --query "diskSizeGB" -o tsv 2>/dev/null || echo 0)
        total_gb=$((total_gb + size))
    done

    local price_per_gb
    price_per_gb=$(get_snapshot_price_per_gb "$region")
    if [[ -z "$price_per_gb" ]]; then
        gum_error "Could not fetch current snapshot pricing for $region."
        echo "Storage: $total_gb GB across ${#snapshot_names[@]} snapshots"
        return
    fi
    local archived_total
    archived_total=$(jq -n --argjson g "$total_gb" --argjson p "$price_per_gb" '(($g * $p) * 100 | round) / 100')

    echo "Storage: $total_gb GB across ${#snapshot_names[@]} snapshots"
    echo "Estimated monthly cost: \$$(printf '%.2f' "$archived_total")"
    echo "Restore estimate: Fast"
}

status_vm() {
    gum_info "Checking status for VM: $vm_name"
    local vm_exists
    vm_exists=$(az vm show -n "$vm_name" -g "$RG" --query "name" -o tsv 2>/dev/null || echo "")

    if [[ -n "$vm_exists" ]]; then
        gum_success "Running"
        print_running_estimate
    elif [[ -f "$manifest_file" ]]; then
        gum_box "Archived"
        print_archived_estimate
    else
        gum_error "VM not found and no archive manifest found."
    fi
}

verify_vm() {
    gum_info "Verifying archive for VM: $vm_name"
    if [[ ! -f "$manifest_file" ]]; then
        gum_error "Manifest missing: $manifest_file"
        exit 1
    fi
    gum_success "Manifest exists."
    
    # Read OS snapshot name from manifest
    local os_snapshot
    os_snapshot=$(jq -r '.archive.osDiskSnapshot // empty' "$manifest_file" 2>/dev/null || echo "")
    if [[ -n "$os_snapshot" ]]; then
        if az snapshot show -n "$os_snapshot" -g "$RG" &>/dev/null; then
            gum_success "OS Snapshot $os_snapshot verified."
        else
            gum_error "OS Snapshot $os_snapshot missing!"
            exit 1
        fi
    fi

    # Read Data snapshot names from manifest
    local data_snapshots
    data_snapshots=($(jq -r '.archive.dataDiskSnapshots[] // empty' "$manifest_file" 2>/dev/null || echo ""))
    for snap in "${data_snapshots[@]}"; do
        if az snapshot show -n "$snap" -g "$RG" &>/dev/null; then
            gum_success "Data Snapshot $snap verified."
        else
            gum_error "Data Snapshot $snap missing!"
            exit 1
        fi
    done
    
    gum_success "Archive verification PASSED."
}

prune_previous_snapshots() {
    local current_os_snapshot="$1"
    shift
    local current_data_snapshots=("$@")
    local snapshot_name
    local current_snapshot
    local is_current

    # Only consider snapshots made by this tool for this VM. Pruning happens
    # after the new archive has verified, so a failed archive cannot remove a
    # prior restore point.
    while IFS= read -r snapshot_name; do
        [[ -z "$snapshot_name" ]] && continue

        is_current=false
        for current_snapshot in "$current_os_snapshot" "${current_data_snapshots[@]}"; do
            if [[ "$snapshot_name" == "$current_snapshot" ]]; then
                is_current=true
                break
            fi
        done

        if [[ "$is_current" == false ]]; then
            gum_spin_wait "Deleting previous snapshot $snapshot_name..." \
                az snapshot delete -g "$RG" -n "$snapshot_name"
            gum_success "Previous snapshot $snapshot_name deleted."
        fi
    done < <(
        az snapshot list -g "$RG" -o json | jq -r --arg vm_name "$vm_name" '
            .[]
            | select(
                (.name | startswith($vm_name + "-osdisk-snap-"))
                or (.name | startswith($vm_name + "-datadisk-"))
            )
            | .name
        '
    )
}

archive_vm() {
    local vm_exists
    vm_exists=$(az vm show -n "$vm_name" -g "$RG" --query "name" -o tsv 2>/dev/null || echo "")
    
    if [[ -z "$vm_exists" ]]; then
        gum_error "VM $vm_name not found in resource group $RG."
        exit 1
    fi

    if ! gum_confirm "Are you sure you want to archive $vm_name? This will STOP, DEALLOCATE, and DELETE the VM."; then
        gum_dim "Archive cancelled."
        exit 0
    fi

    gum_info "Archiving VM: $vm_name"
    
    # 1. Stop / Deallocate VM first to ensure volume consistency
    gum_spin_wait "Stopping and Deallocating VM (shutting down first)..." az vm deallocate -n "$vm_name" -g "$RG" --no-wait
    while true; do
        local power_state
        power_state=$(az vm get-instance-view -n "$vm_name" -g "$RG" --query "instanceView.statuses[?starts_with(code, 'PowerState')].code" -o tsv)
        if [[ "$power_state" == "PowerState/deallocated" ]]; then
            break
        fi
        sleep 5
    done
    gum_success "VM successfully Stopped and Deallocated."

    # 2. Discover configuration and auto-discover volumes
    gum_spin_quick "Discovering VM configuration..." az vm show -n "$vm_name" -g "$RG" -o json > "$manifest_file"
    
    local os_disk_id
    os_disk_id=$(jq -r '.storageProfile.osDisk.managedDisk.id' "$manifest_file")
    
    local data_disk_ids
    data_disk_ids=($(jq -r '.storageProfile.dataDisks[].managedDisk.id // empty' "$manifest_file"))
    
    gum_success "Saved VM configuration. Auto-discovered $((${#data_disk_ids[@]} + 1)) volumes (1 OS disk, ${#data_disk_ids[@]} Data disks)."

    local tmp_manifest="${manifest_file}.tmp"

    # Capture PremiumV2/Ultra IOPS+throughput before it's lost (see
    # disk_perf_tsv above) so restore_vm can reapply it explicitly.
    local os_perf os_iops os_mbps
    os_perf=$(disk_perf_tsv "$os_disk_id")
    os_iops=$(cut -f1 <<<"$os_perf")
    os_mbps=$(cut -f2 <<<"$os_perf")
    if [[ -n "$os_iops" && -n "$os_mbps" ]]; then
        jq --argjson iops "$os_iops" --argjson mbps "$os_mbps" \
            '.archive.osDiskIops = $iops | .archive.osDiskMbps = $mbps' \
            "$manifest_file" > "$tmp_manifest"
        mv "$tmp_manifest" "$manifest_file"
        gum_dim "Captured OS disk performance: ${os_iops} IOPS / ${os_mbps} MB/s."
    fi

    local data_iops_json="[]" data_mbps_json="[]"
    for disk_id in "${data_disk_ids[@]}"; do
        local d_perf d_iops d_mbps
        d_perf=$(disk_perf_tsv "$disk_id")
        d_iops=$(cut -f1 <<<"$d_perf")
        d_mbps=$(cut -f2 <<<"$d_perf")
        data_iops_json=$(jq --argjson v "${d_iops:-null}" '. + [$v]' <<<"$data_iops_json")
        data_mbps_json=$(jq --argjson v "${d_mbps:-null}" '. + [$v]' <<<"$data_mbps_json")
    done
    if [[ ${#data_disk_ids[@]} -gt 0 ]]; then
        jq --argjson iops "$data_iops_json" --argjson mbps "$data_mbps_json" \
            '.archive.dataDiskIops = $iops | .archive.dataDiskMbps = $mbps' \
            "$manifest_file" > "$tmp_manifest"
        mv "$tmp_manifest" "$manifest_file"
        gum_dim "Captured data disk performance for restore."
    fi

    local snap_suffix="-snap-$(date +%Y%m%d%H%M%S)"

    # 3. Snapshot OS Disk
    local os_snap_name="${vm_name}-osdisk${snap_suffix}"
    gum_spin_wait "Snapshotting OS disk (incremental)..." az snapshot create -g "$RG" -n "$os_snap_name" --source "$os_disk_id" --incremental -o none

    # Update manifest with OS snapshot name
    jq --arg snap "$os_snap_name" '.archive.osDiskSnapshot = $snap' "$manifest_file" > "$tmp_manifest"
    mv "$tmp_manifest" "$manifest_file"
    gum_success "OS Disk snapshotted: $os_snap_name."

    # 4. Snapshot Data Disks
    local i=0
    local data_snaps=()
    for disk_id in "${data_disk_ids[@]}"; do
        local disk_name
        disk_name=$(echo "$disk_id" | awk -F'/' '{print $NF}')
        local data_snap_name="${vm_name}-datadisk-${i}${snap_suffix}"
        
        gum_spin_wait "Snapshotting Data Disk ($disk_name, incremental)..." az snapshot create -g "$RG" -n "$data_snap_name" --source "$disk_id" --incremental -o none
        data_snaps+=("$data_snap_name")
        i=$((i+1))
    done

    # Update manifest with Data snapshot names
    if [[ ${#data_snaps[@]} -gt 0 ]]; then
        jq --argjson snaps "$(printf '%s\n' "${data_snaps[@]}" | jq -R . | jq -s .)" '.archive.dataDiskSnapshots = $snaps' "$manifest_file" > "$tmp_manifest"
        mv "$tmp_manifest" "$manifest_file"
        gum_success "${#data_snaps[@]} Data Disks snapshotted."
    fi

    # 5. Verify Archive
    verify_vm

    # Keep only this verified archive's snapshots for the VM.
    prune_previous_snapshots "$os_snap_name" "${data_snaps[@]}"

    # 6. Delete VM and Managed Disks
    if gum_confirm "Archive verified. Delete VM $vm_name and its associated managed disks?"; then
        # Delete VM
        gum_spin_wait "Deleting VM..." az vm delete -n "$vm_name" -g "$RG" --yes
        gum_success "VM deleted successfully."
        
        # Delete OS Disk
        local os_disk_name
        os_disk_name=$(echo "$os_disk_id" | awk -F'/' '{print $NF}')
        gum_spin_wait "Deleting OS Disk $os_disk_name..." az disk delete -n "$os_disk_name" -g "$RG" --yes
        gum_success "OS Disk deleted."

        # Delete Data Disks
        for disk_id in "${data_disk_ids[@]}"; do
            local data_disk_name
            data_disk_name=$(echo "$disk_id" | awk -F'/' '{print $NF}')
            gum_spin_wait "Deleting Data Disk $data_disk_name..." az disk delete -n "$data_disk_name" -g "$RG" --yes
            gum_success "Data Disk $data_disk_name deleted."
        done
    else
        gum_dim "VM and disk deletion skipped."
    fi

    gum_box_success "Archive complete for $vm_name."
}

restore_vm() {
    local vm_exists
    vm_exists=$(az vm show -n "$vm_name" -g "$RG" --query "name" -o tsv 2>/dev/null || echo "")
    if [[ -n "$vm_exists" ]]; then
        gum_error "VM $vm_name is already running or exists."
        exit 1
    fi

    if [[ ! -f "$manifest_file" ]]; then
        gum_error "Cannot restore. No manifest found for $vm_name."
        exit 1
    fi

    gum_info "Restoring VM: $vm_name"
    
    # 1. Restore OS Disk
    local os_snapshot
    os_snapshot=$(jq -r '.archive.osDiskSnapshot // empty' "$manifest_file")
    if [[ -z "$os_snapshot" ]]; then
        gum_error "No OS snapshot found in manifest to restore from."
        exit 1
    fi

    local os_snapshot_id
    os_snapshot_id=$(az snapshot show -n "$os_snapshot" -g "$RG" --query "id" -o tsv)

    local os_sector_size
    os_sector_size=$(az snapshot show -n "$os_snapshot" -g "$RG" --query "creationData.logicalSectorSize" -o tsv 2>/dev/null || echo "")
    local os_sku_args=()
    if [[ "$os_sector_size" == "4096" ]]; then
        os_sku_args=(--sku PremiumV2_LRS)
        local os_iops os_mbps
        os_iops=$(jq -r '.archive.osDiskIops // empty' "$manifest_file")
        os_mbps=$(jq -r '.archive.osDiskMbps // empty' "$manifest_file")
        if [[ -n "$os_iops" && -n "$os_mbps" ]]; then
            os_sku_args+=(--disk-iops-read-write "$os_iops" --disk-mbps-read-write "$os_mbps")
            gum_dim "Restoring OS disk performance: ${os_iops} IOPS / ${os_mbps} MB/s."
        fi
    fi

    local os_disk_name="${vm_name}-osdisk-restored-$(date +%Y%m%d%H%M%S)"
    gum_spin_wait "Creating managed OS disk from snapshot..." az disk create -g "$RG" -n "$os_disk_name" --source "$os_snapshot_id" "${os_sku_args[@]}" -o none
    local os_disk_id
    os_disk_id=$(az disk show -n "$os_disk_name" -g "$RG" --query "id" -o tsv)
    gum_success "OS Disk created: $os_disk_name."

    # 2. Restore Data Disks
    local data_snapshots
    data_snapshots=($(jq -r '.archive.dataDiskSnapshots[] // empty' "$manifest_file" 2>/dev/null || echo ""))
    local restored_data_disk_ids=()
    
    local idx=0
    for snap in "${data_snapshots[@]}"; do
        local snap_id
        snap_id=$(az snapshot show -n "$snap" -g "$RG" --query "id" -o tsv)
        local sector_size
        sector_size=$(az snapshot show -n "$snap" -g "$RG" --query "creationData.logicalSectorSize" -o tsv 2>/dev/null || echo "")
        local sku_args=()
        if [[ "$sector_size" == "4096" ]]; then
            sku_args=(--sku PremiumV2_LRS)
            local d_iops d_mbps
            d_iops=$(jq -r ".archive.dataDiskIops[$idx] // empty" "$manifest_file")
            d_mbps=$(jq -r ".archive.dataDiskMbps[$idx] // empty" "$manifest_file")
            if [[ -n "$d_iops" && -n "$d_mbps" ]]; then
                sku_args+=(--disk-iops-read-write "$d_iops" --disk-mbps-read-write "$d_mbps")
                gum_dim "Restoring data disk $idx performance: ${d_iops} IOPS / ${d_mbps} MB/s."
            fi
        fi

        local restored_data_disk_name="${vm_name}-datadisk-${idx}-restored-$(date +%Y%m%d%H%M%S)"
        
        gum_spin_wait "Creating managed data disk from snapshot $snap..." az disk create -g "$RG" -n "$restored_data_disk_name" --source "$snap_id" "${sku_args[@]}" -o none
        local restored_data_disk_id
        restored_data_disk_id=$(az disk show -n "$restored_data_disk_name" -g "$RG" --query "id" -o tsv)
        
        restored_data_disk_ids+=("$restored_data_disk_id")
        gum_success "Data Disk created: $restored_data_disk_name."
        idx=$((idx+1))
    done

    # 3. Recreate VM with OS Disk
    local vm_size
    vm_size=$(jq -r '.hardwareProfile.vmSize' "$manifest_file")
    
    local vm_priority
    vm_priority=$(jq -r '.priority // empty' "$manifest_file")
    local extra_vm_args=()
    if [[ "$vm_priority" == "Spot" ]]; then
        local eviction_policy
        eviction_policy=$(jq -r '.evictionPolicy // "Deallocate"' "$manifest_file")
        extra_vm_args=(--priority Spot --eviction-policy "$eviction_policy" --max-price -1)
    fi

    gum_spin_wait "Creating VM with attached OS disk..." az vm create -g "$RG" -n "$vm_name" --attach-os-disk "$os_disk_id" --os-type Linux --size "$vm_size" "${extra_vm_args[@]}" -o none
    gum_success "VM created."
    remove_stale_ssh_host_key

    # 4. Attach Data Disks
    idx=0
    for data_disk_id in "${restored_data_disk_ids[@]}"; do
        local lun
        lun=$(jq -r ".storageProfile.dataDisks[$idx].lun" "$manifest_file")
        gum_spin_wait "Attaching restored data disk with LUN $lun..." az vm disk attach -g "$RG" --vm-name "$vm_name" --disk "$data_disk_id" --lun "$lun"
        gum_success "Data Disk attached at LUN $lun."
        idx=$((idx+1))
    done

    mount_restored_data_disks "${#restored_data_disk_ids[@]}"

    gum_box_success "Restore complete for $vm_name."
}

ensure_az_login

case "$command" in
    archive) archive_vm ;;
    restore) restore_vm ;;
    status) status_vm ;;
    verify) verify_vm ;;
    *)
        echo "Unknown command: $command"
        echo "Usage: azure-vm <archive|restore|status|verify> <vm-name>"
        exit 1
        ;;
esac
