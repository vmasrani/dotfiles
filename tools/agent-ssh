#!/usr/bin/env zsh
# agent-ssh - dispatch and track the headless Claude agent (claude-agent.yml).
#
# Despite the name there is no SSH any more: the agent runs as an ordinary
# GitHub Actions job (anthropics/claude-code-action), works one issue on branch
# issue-N cut from a base branch, opens a PR and comments the link on the issue.
# This tool dispatches that workflow and follows its runs.
#
# No args -> interactive menu. Subcommands:
#   run <issue> [effort] [--base B] [--brief TEXT]   dispatch, print the run URL
#   status [issue]    latest agent runs (+ the PR for an issue)
#   watch <run-id>    follow a run until it ends
#   kill <run-id>     cancel a run
#   build             rebuild the CI agent image (build-agent-image.yml)
#   help
#
# Env overrides:
#   AGENT_SSH_REPO   repo hosting the workflows (default sophiaconsulting/cartridge)
#   AGENT_SSH_REF    branch to dispatch from    (default dev)
#
# Fails loud: every error names what failed and how to fix it. No silent fallbacks.

# shellcheck disable=SC1091  # gum_utils.sh is sourced at runtime.
emulate -L zsh
setopt pipe_fail 2>/dev/null || true

source "${HOME}/dotfiles/shell/gum_utils.sh" 2>/dev/null || true

# ── Config ──────────────────────────────────────────────────────────────────
REPO="${AGENT_SSH_REPO:-sophiaconsulting/cartridge}"
REF="${AGENT_SSH_REF:-dev}"
AGENT_WF="claude-agent.yml"
BUILD_WF="build-agent-image.yml"
EFFORTS=(low medium high)

die() { gum_error "$@"; exit 1; }

# ── Pure, testable helpers ────────────────────────────────────────────────────

# An issue number: a positive whole number (a leading # is not accepted).
valid_issue() {
    [[ "$1" == <1-> ]]
}

# Agent effort: one of low | medium | high.
valid_effort() {
    (( ${EFFORTS[(Ie)$1]} ))
}

# Print the issue number from a run title ("agent issue #123"); return 1 if none.
issue_from_title() {
    local n="${1##*#}"
    [[ "$1" == *"#"* && "$n" == <1-> ]] || return 1
    printf '%s\n' "$n"
}

# Read `gh run list --json databaseId,displayTitle,status,conclusion` on stdin
# and print "<id>  #<issue>  <status>  <conclusion>" rows; $1 (optional) keeps
# only runs for that issue. Prints nothing when no run matches.
format_runs() {
    jq -r --arg issue "${1:-}" '
        .[]
        | (.displayTitle | capture("#(?<n>[0-9]+)") | .n) as $n
        | select($issue == "" or $n == $issue)
        | "\(.databaseId)  #\($n)  \(.status)  \(if .conclusion == "" or .conclusion == null then "-" else .conclusion end)"
    '
}

# The `gh workflow run` flags for a dispatch, one argument per line.
# Usage: dispatch_fields <issue> <effort> <base> <brief>
dispatch_fields() {
    local issue="$1" effort="$2" base="$3" brief="$4"
    printf '%s\n' -f "issue=${issue}" -f "effort=${effort}" -f "base=${base}"
    [[ -z "$brief" ]] || printf '%s\n' -f "brief=${brief}"
}

run_url() { printf 'https://github.com/%s/actions/runs/%s\n' "$REPO" "$1"; }

# ── gh-backed helpers ─────────────────────────────────────────────────────────

# Poll for a run of <workflow> created after <since-iso>; echo its id or return 1.
find_new_run() {
    local wf="$1" since="$2" i row created id
    for i in {1..15}; do   # ~60s at 4s
        row="$(gh run list --repo "$REPO" --workflow "$wf" --limit 1 \
            --json databaseId,createdAt --jq '.[0]' 2>/dev/null || true)"
        if [[ -n "$row" && "$row" != null ]]; then
            created="$(printf '%s' "$row" | jq -r '.createdAt // empty')"
            id="$(printf '%s' "$row" | jq -r '.databaseId // empty')"
            if [[ -n "$created" && "$created" > "$since" ]]; then
                printf '%s\n' "$id"
                return 0
            fi
        fi
        sleep 4
    done
    return 1
}

# Ask for a value with a default; returns the default in non-interactive mode.
ask() {
    local label="$1" default="$2" val
    if command -v gum >/dev/null 2>&1 && [[ -z "${NO_GUM:-}" && -t 0 ]]; then
        val="$(gum input --prompt "${label} " --value "$default")" || return 1
    else
        val="$default"
    fi
    printf '%s' "${val:-$default}"
}

# Fail loud unless the argument is a numeric run id.
need_run_id() {
    [[ "$1" == <1-> ]] || die "Expected a numeric run id, got '${1:-}'. List runs with: agent-ssh status"
}

# ── Preflight ─────────────────────────────────────────────────────────────────
preflight() {
    command -v gh >/dev/null 2>&1 || die "The GitHub CLI 'gh' is not installed. Install it with: brew install gh"
    gh auth status >/dev/null 2>&1 || die "You are not logged in to GitHub. Fix it with: gh auth login"
    command -v jq >/dev/null 2>&1 || die "'jq' is not installed. Install it with: brew install jq"
    gh api "repos/${REPO}" >/dev/null 2>&1 || die "Cannot reach ${REPO} (no access, or wrong AGENT_SSH_REPO). Check that your GitHub account can see it."
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_run() {
    local issue="" effort="medium" base="dev" brief=""
    local -a pos
    while (( $# > 0 )); do
        case "$1" in
            --base)  (( $# >= 2 )) || die "--base needs a branch name."; base="$2"; shift 2 ;;
            --brief) (( $# >= 2 )) || die "--brief needs text."; brief="$2"; shift 2 ;;
            -*)      die "Unknown option: $1. Usage: agent-ssh run <issue> [effort] [--base B] [--brief TEXT]" ;;
            *)       pos+=("$1"); shift ;;
        esac
    done
    (( ${#pos[@]} >= 1 && ${#pos[@]} <= 2 )) \
        || die "Usage: agent-ssh run <issue> [effort] [--base B] [--brief TEXT]"
    issue="${pos[1]}"
    (( ${#pos[@]} == 2 )) && effort="${pos[2]}"
    valid_issue "$issue" || die "Issue must be a whole number like 1932, got '${issue}'."
    valid_effort "$effort" || die "Effort must be one of: ${EFFORTS[*]} (got '${effort}')."
    preflight

    local -a fields; fields=("${(@f)$(dispatch_fields "$issue" "$effort" "$base" "$brief")}")
    local since; since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    gum_info "Dispatching the agent on issue #${issue} (effort ${effort}, base ${base})..."
    gh workflow run "$AGENT_WF" --repo "$REPO" --ref "$REF" "${fields[@]}" \
        || die "Could not dispatch ${AGENT_WF} on ${REF}. Run 'gh auth status', confirm you can dispatch workflows in ${REPO}, and that the file exists on ${REF}."

    local id
    id="$(find_new_run "$AGENT_WF" "$since")" \
        || die "Dispatched, but no run appeared within 60s. Check: https://github.com/${REPO}/actions/workflows/${AGENT_WF}"
    gum_success "Agent run started: $(run_url "$id")"
    gum_dim "  Follow it with: agent-ssh watch ${id}   End it with: agent-ssh kill ${id}"
}

cmd_status() {
    local issue="${1:-}"
    [[ -z "$issue" ]] || valid_issue "$issue" || die "Issue must be a whole number, got '${issue}'."
    preflight
    local runs
    runs="$(gh run list --repo "$REPO" --workflow "$AGENT_WF" --limit 30 \
        --json databaseId,displayTitle,status,conclusion | format_runs "$issue")" \
        || die "Could not list ${AGENT_WF} runs in ${REPO}. Check your connection and 'gh auth status'."
    gum_info "Latest agent runs${issue:+ for issue #${issue}}:"
    if [[ -z "$runs" ]]; then
        gum_dim "  none"
    else
        print -r -- "$runs" | head -10 | while IFS= read -r line; do gum_dim "  $line"; done
    fi
    [[ -n "$issue" ]] || return 0

    local prs
    prs="$(gh pr list --repo "$REPO" --state all --head "issue-${issue}" \
        --json number,state,url --jq '.[] | "#\(.number)  \(.state)  \(.url)"')" \
        || die "Could not look up the PR for issue #${issue}."
    gum_info "PR for issue #${issue}:"
    if [[ -z "$prs" ]]; then
        gum_dim "  none yet"
    else
        print -r -- "$prs" | while IFS= read -r line; do gum_dim "  $line"; done
    fi
}

cmd_watch() {
    need_run_id "${1:-}"
    preflight
    gh run watch "$1" --repo "$REPO" \
        || die "Could not watch run $1. Check the id with: agent-ssh status"
}

cmd_kill() {
    need_run_id "${1:-}"
    preflight
    gh run cancel "$1" --repo "$REPO" \
        || die "Could not cancel run $1 (it may have already finished). Check: $(run_url "$1")"
    gum_success "Cancelled run $1"
}

cmd_build() {
    preflight
    if ! gum_confirm "Build a fresh CI agent image now? (~15-20 min)"; then
        gum_info "Cancelled."
        return 0
    fi
    local dref; dref="$(ask "Which dotfiles ref to bake in:" "main")" || { gum_info "Cancelled."; return 0; }

    local since; since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    gum_info "Starting the image build (ref ${REF}, dotfiles ${dref})..."
    gh workflow run "$BUILD_WF" --repo "$REPO" --ref "$REF" \
        -f dotfiles_ref="$dref" -f push=true \
        || die "Failed to start the build. Run 'gh auth status' and confirm you can dispatch workflows in ${REPO}."

    local id
    id="$(find_new_run "$BUILD_WF" "$since")" \
        || die "The build was dispatched but no run appeared within 60s. Check: https://github.com/${REPO}/actions/workflows/${BUILD_WF}"
    gum_success "Build started: $(run_url "$id")"

    local start=$SECONDS
    if gum_spin_wait "Building the image (this takes ~15-20 min)..." \
        gh run watch "$id" --repo "$REPO" --exit-status; then
        gum_box_success "Image built in ~$(( (SECONDS - start) / 60 )) min and published." "$(run_url "$id")"
    else
        gum_error "The image build failed. Recent errors:"
        gh run view "$id" --repo "$REPO" --log-failed 2>/dev/null | tail -20
        die "See the full run: $(run_url "$id")"
    fi
}

cmd_help() {
    cat <<'EOF'
agent-ssh - dispatch and track the headless Claude agent (claude-agent.yml).

Usage:
  agent-ssh                 Open the interactive menu.
  agent-ssh run <issue> [effort] [--base B] [--brief TEXT]
                            Start the agent on an issue (effort low|medium|high,
                            default medium; base default dev) and print the run URL.
  agent-ssh status [issue]  Latest agent runs; with an issue, also its PR.
  agent-ssh watch <run-id>  Follow a run until it ends.
  agent-ssh kill <run-id>   Cancel a run.
  agent-ssh build           Rebuild the CI agent image.
  agent-ssh help            Show this help.

The agent works issue N on branch issue-N, opens a PR into the base branch and
comments the link on the issue. There is no terminal to connect to.

Environment:
  AGENT_SSH_REPO   repo hosting the workflows (default sophiaconsulting/cartridge)
  AGENT_SSH_REF    branch to dispatch from    (default dev)
EOF
}

cmd_menu() {
    local choice issue effort base brief id
    choice="$(gum_choose --header "What would you like to do?" \
        "run     - start the agent on an issue" \
        "status  - latest agent runs" \
        "watch   - follow a run" \
        "kill    - cancel a run" \
        "build   - rebuild the CI agent image" \
        "help    - show help")"
    case "$choice" in
        run*)
            issue="$(ask "Issue number:" "")" || return 0
            effort="$(gum_choose --header "Effort:" "${EFFORTS[@]}")" || return 0
            base="$(ask "Base branch:" "dev")" || return 0
            brief="$(ask "Brief (optional):" "")" || return 0
            if [[ -n "$brief" ]]; then cmd_run "$issue" "$effort" --base "$base" --brief "$brief"
            else cmd_run "$issue" "$effort" --base "$base"; fi ;;
        status*)  cmd_status "$(ask "Issue number (blank for all):" "")" ;;
        watch*)   id="$(ask "Run id:" "")" || return 0; cmd_watch "$id" ;;
        kill*)    id="$(ask "Run id:" "")" || return 0; cmd_kill "$id" ;;
        build*)   cmd_build ;;
        help*)    cmd_help ;;
        "")       gum_info "Nothing selected." ;;
        *)        cmd_help ;;
    esac
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
main() {
    local cmd="${1:-}"
    (( $# > 0 )) && shift
    case "$cmd" in
        ""|menu)        cmd_menu ;;
        run)            cmd_run "$@" ;;
        status)         cmd_status "$@" ;;
        watch)          cmd_watch "$@" ;;
        kill)           cmd_kill "$@" ;;
        build)          cmd_build ;;
        help|-h|--help) cmd_help ;;
        # Hidden hooks for the hermetic test suite.
        __valid-issue)      valid_issue "$1" ;;
        __valid-effort)     valid_effort "$1" ;;
        __issue-from-title) issue_from_title "$1" ;;
        __format-runs)      format_runs "$@" ;;
        __dispatch-fields)  dispatch_fields "$@" ;;
        *)
            gum_error "Unknown command: ${cmd}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
