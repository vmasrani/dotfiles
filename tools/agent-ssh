#!/usr/bin/env zsh
# agent-ssh - run Claude Code agents on GitHub issues, and SSH into them.
#
#   agent-ssh 12            dispatch an agent on issue #12 and drop straight into its
#                           live Claude Code tmux session
#   agent-ssh 12 13 14      dispatch several agents (no attach); later: agent-ssh attach 13
#   agent-ssh connect       a plain terminal in a fresh agent-image job (no agent)
#
# The agent runs in a GitHub Actions job on the published cartridge-agent image; an
# Upterm SSH bridge attaches you to it. No args -> interactive menu.
# Subcommands: connect | attach | status | build | kill | help.
#
# Env overrides:
#   AGENT_SSH_REPO       repo hosting the workflows   (default sophiaconsulting/cartridge)
#   AGENT_SSH_REF        pin the branch the workflows run from (default: auto-resolved)
#   AGENT_SSH_IMAGE_TAG  image tag to boot            (default latest)
#
# Fails loud: every error names what failed and how to fix it. No silent fallbacks.

# shellcheck disable=SC1091  # gum_utils.sh is sourced at runtime.
emulate -L zsh
setopt pipe_fail 2>/dev/null || true

source "${HOME}/dotfiles/shell/gum_utils.sh" 2>/dev/null || true

# ── Config ──────────────────────────────────────────────────────────────────
REPO="${AGENT_SSH_REPO:-sophiaconsulting/cartridge}"
IMAGE_TAG="${AGENT_SSH_IMAGE_TAG:-latest}"
PKG_ORG="sophiaconsulting"
PKG_NAME="cartridge-agent"
BUILD_WF="build-agent-image.yml"
SSH_WF="ssh-into-agent-image.yml"
SSH_WF_PATH=".github/workflows/${SSH_WF}"
# Branches to try, in order, when locating the SSH workflow. The feature branch
# remains a candidate until the workflow merges to dev.
CANDIDATE_REFS=(dev agent-image-slim)
CONNECT_TIMEOUT_SECS=$((8 * 60))   # hard cap waiting for the SSH address
AGENT_SECRET="CLAUDE_CODE_OAUTH_TOKEN"   # repo secret the agent job authenticates Claude with
AGENT_DEFAULT_MINUTES=120
AGENT_DEFAULT_MODEL="claude-opus-4-8"

die() { gum_error "$@"; exit 1; }

# ── Pure, testable helpers ────────────────────────────────────────────────────

# Extract the first "ssh <token>@uptermd.upterm.dev" from text ($* or stdin).
# Prints it and returns 0; prints nothing and returns 1 when absent.
extract_ssh_address() {
    local input addr
    if (( $# > 0 )); then input="$*"; else input="$(cat)"; fi
    addr="$(printf '%s\n' "$input" \
        | grep -oE 'ssh [A-Za-z0-9_-]+@uptermd\.upterm\.dev' \
        | head -1)"
    [[ -n "$addr" ]] || return 1
    printf '%s\n' "$addr"
}

# Valid connection window: a whole number of minutes in [5, 360].
valid_minutes() {
    [[ "$1" == <5-360> ]]
}

# A positive integer with no leading zero: the only thing that names an issue.
is_issue_number() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

# The exact run title the workflow gives an agent run; the tool finds runs by it.
agent_title() { printf 'agent issue #%s\n' "$1"; }

# Split "$@" into flags (accepted in any position) and positionals. Sets
# OPT_MINUTES, OPT_MODEL, OPT_NO_ATTACH and the POSITIONAL array; on a bad flag
# prints why to stderr and returns 1.
parse_args() {
    OPT_MINUTES="" OPT_MODEL="" OPT_NO_ATTACH=""
    POSITIONAL=()
    while (( $# > 0 )); do
        case "$1" in
            -m|--minutes|--model)
                if [[ -z "${2:-}" ]]; then
                    print -u2 -r -- "Flag $1 needs a value."
                    return 1
                fi
                if [[ "$1" == --model ]]; then OPT_MODEL="$2"; else OPT_MINUTES="$2"; fi
                shift 2 ;;
            --no-attach) OPT_NO_ATTACH=1; shift ;;
            -*) print -u2 -r -- "Unknown flag: $1 (see: agent-ssh help)"; return 1 ;;
            *)  POSITIONAL+=("$1"); shift ;;
        esac
    done
}

# Echo the first candidate ref that contains the given file; return 1 if none.
# Usage: resolve_workflow_ref <repo> <file> <ref>...
# NB: the local is `wf_path`, never `path` — in zsh `path` is the array tied to
# $PATH, so a `local path=...` would clobber PATH and break every later command.
resolve_workflow_ref() {
    local repo="$1" wf_path="$2"; shift 2
    local ref
    for ref in "$@"; do
        if gh api "repos/${repo}/contents/${wf_path}?ref=${ref}" >/dev/null 2>&1; then
            printf '%s\n' "$ref"
            return 0
        fi
    done
    return 1
}

# ── gh-backed helpers ─────────────────────────────────────────────────────────

# Resolve WORKFLOW_REF once (honours AGENT_SSH_REF), or die with guidance.
workflow_ref() {
    if [[ -n "${AGENT_SSH_REF:-}" ]]; then
        printf '%s\n' "$AGENT_SSH_REF"
        return 0
    fi
    local ref
    if ! ref="$(resolve_workflow_ref "$REPO" "$SSH_WF_PATH" "${CANDIDATE_REFS[@]}")"; then
        die "Could not find ${SSH_WF} on any of: ${CANDIDATE_REFS[*]} in ${REPO}. Set AGENT_SSH_REF to the branch that has it, or merge the workflow PR."
    fi
    printf '%s\n' "$ref"
}

# Ask for a value with a default; returns the default in non-interactive mode.
ask() {
    local label="$1" default="$2" val
    if command -v gum >/dev/null 2>&1 && [[ -z "${NO_GUM:-}" && -t 0 ]]; then
        val="$(gum input --prompt "${label} " --value "$default")" || return 1
    else
        val="$default"
    fi
    printf '%s' "${val:-$default}"
}

# databaseId of the workflow's newest run, or empty.
newest_run_id() {
    gh run list --repo "$REPO" --workflow "$1" --limit 1 \
        --json databaseId --jq '.[0].databaseId // empty' 2>/dev/null
}

# Poll for a run of <workflow> created at/after <since-iso>; echo its id or
# return 1. With <title>, only a run whose displayTitle equals it exactly counts,
# so several agents dispatched back to back never pick up each other's runs.
find_new_run() {
    local wf="$1" since="$2" title="${3:-}" i id
    for i in {1..15}; do   # ~60s at 4s
        id="$(gh run list --repo "$REPO" --workflow "$wf" --limit 20 \
            --json databaseId,createdAt,displayTitle 2>/dev/null \
            | jq -r --arg since "$since" --arg title "$title" \
                'map(select(.createdAt >= $since and ($title == "" or .displayTitle == $title)))
                 | .[0].databaseId // empty' 2>/dev/null || true)"
        if [[ -n "$id" ]]; then
            printf '%s\n' "$id"
            return 0
        fi
        sleep 4
    done
    return 1
}

# TSV "<run id><tab><issue>" for every unfinished agent run. Returns 2 (message on
# stderr) when the GitHub API fails, so "none running" is never a disguised outage.
active_agent_runs() {
    local body rc
    body="$(gh run list --repo "$REPO" --workflow "$SSH_WF" --limit 30 \
        --json databaseId,displayTitle,status 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        print -u2 -r -- "GitHub API failed while listing agent runs: ${body}"
        return 2
    fi
    printf '%s\n' "$body" | jq -r '.[]
        | select(.status != "completed")
        | (.displayTitle | capture("^agent issue #(?<n>[0-9]+)$")) as $m
        | "\(.databaseId)\t\($m.n)"'
}

# Echo the run id of the unfinished agent run for <issue>; return 1 when none.
find_active_run() {
    local issue="$1" runs id
    runs="$(active_agent_runs)" || return 2
    id="$(print -r -- "$runs" | awk -F'\t' -v n="$issue" '$2 == n { print $1; exit }')"
    [[ -n "$id" ]] || return 1
    printf '%s\n' "$id"
}

# Read the titled check annotation emitted by the running workflow. Container-job
# logs are unavailable until completion, but check annotations are live.
#
# Returns 0 and prints the validated SSH command when ready, 1 while the job or
# annotation is not ready (including malformed/missing annotation text), and 2
# after a GitHub API failure.
fetch_ssh_annotation() {
    local run_id="$1" check_url annotations_path response rc

    response="$(gh api "repos/${REPO}/actions/runs/${run_id}/jobs" \
        --jq '.jobs[0].check_run_url // empty' 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        print -u2 -r -- "GitHub API failed while reading jobs for run ${run_id}: ${response}"
        return 2
    fi
    check_url="$response"
    [[ -n "$check_url" ]] || return 1

    annotations_path="${check_url#https://api.github.com/}/annotations"
    response="$(gh api "$annotations_path" \
        --jq '.[] | select(.title == "agent-ssh-address") | .message' 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        print -u2 -r -- "GitHub API failed while reading check annotations for run ${run_id}: ${response}"
        return 2
    fi
    extract_ssh_address "$response"
}

# Read the workflow run state as "<status><tab><conclusion>". Returns 2 after a
# GitHub API failure so waiting never disguises an unavailable API as "not ready".
fetch_run_status() {
    local run_id="$1" response rc
    response="$(gh api "repos/${REPO}/actions/runs/${run_id}" \
        --jq '[.status, (.conclusion // "")] | @tsv' 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        print -u2 -r -- "GitHub API failed while reading run ${run_id}: ${response}"
        return 2
    fi
    printf '%s\n' "$response"
}

# Poll a running check until its stable address annotation appears.
wait_for_ssh_address() {
    local run_id="$1" timeout="${2:-$CONNECT_TIMEOUT_SECS}" interval="${3:-10}"
    local waited=0 addr state run_status conclusion rc
    while (( waited < timeout )); do
        addr="$(fetch_ssh_annotation "$run_id")"
        rc=$?
        case "$rc" in
            0) printf '%s\n' "$addr"; return 0 ;;
            1) ;;
            *) return 2 ;;
        esac

        state="$(fetch_run_status "$run_id")"
        rc=$?
        (( rc == 0 )) || return 2
        run_status="${state%%$'\t'*}"
        conclusion="${state#*$'\t'}"
        if [[ "$run_status" == "completed" ]]; then
            print -u2 -r -- "Run ${run_id} completed with conclusion '${conclusion:-unknown}' before publishing an SSH address."
            return 3
        fi

        sleep "$interval"
        (( waited += interval ))
    done
    return 1
}

run_url() { printf 'https://github.com/%s/actions/runs/%s\n' "$REPO" "$1"; }

# ── Preflight ─────────────────────────────────────────────────────────────────
preflight() {
    command -v gh >/dev/null 2>&1 || die "The GitHub CLI 'gh' is not installed. Install it with: brew install gh"
    gh auth status >/dev/null 2>&1 || die "You are not logged in to GitHub. Fix it with: gh auth login"
    command -v ssh >/dev/null 2>&1 || die "'ssh' was not found on your PATH. Install the OpenSSH client."
    command -v jq >/dev/null 2>&1 || die "'jq' is not installed. Install it with: brew install jq"
    gh api "repos/${REPO}" >/dev/null 2>&1 || die "Cannot reach ${REPO} (no access, or wrong AGENT_SSH_REPO). Check that your GitHub account can see it."
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_status() {
    preflight
    gum_info "Latest published images (${PKG_NAME}):"
    # Fetch the raw body+error together so we can tell the three cases apart:
    #   403 -> the login cannot read packages (scope), 404 -> package not built
    #   yet, 200 -> show versions. `connect` never calls this, so a 403 here can
    #   never block connecting (the job pulls the image with its own token).
    local body rc versions
    body="$(gh api "/orgs/${PKG_ORG}/packages/container/${PKG_NAME}/versions" 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        if [[ "$body" == *"(HTTP 403)"* || "$body" == *"read:packages"* ]]; then
            die "Your GitHub login cannot read packages — run: gh auth refresh -h github.com -s read:packages"
        elif [[ "$body" == *"(HTTP 404)"* || "$body" == *"Not Found"* ]]; then
            die "No image is published yet — run: agent-ssh build"
        else
            die "Could not read published images for ${PKG_NAME}: ${body}"
        fi
    fi
    versions="$(printf '%s\n' "$body" \
        | jq -r '.[0:3][] | "\(.metadata.container.tags | join(",")) \(.created_at)"' 2>/dev/null)"
    [[ -n "$versions" ]] || die "No image is published yet — run: agent-ssh build"
    print -r -- "$versions" | while IFS= read -r line; do gum_dim "  $line"; done

    local wf title runs
    for wf in "$BUILD_WF" "$SSH_WF"; do
        case "$wf" in
            "$BUILD_WF") title="Image builds in progress" ;;
            *)           title="SSH sessions in progress" ;;
        esac
        runs="$(gh run list --repo "$REPO" --workflow "$wf" --status in_progress \
            --json databaseId,displayTitle,createdAt \
            --jq '.[] | "\(.databaseId)  \(.displayTitle)  (\(.createdAt))"' 2>/dev/null || true)"
        gum_info "$title:"
        if [[ -z "$runs" ]]; then
            gum_dim "  none"
        else
            print -r -- "$runs" | while IFS= read -r line; do gum_dim "  $line"; done
        fi
    done
}

cmd_build() {
    preflight
    local ref; ref="$(workflow_ref)" || exit 1
    if ! gum_confirm "Build a fresh agent image now? (~15-20 min)"; then
        gum_info "Cancelled."
        return 0
    fi
    local dref; dref="$(ask "Which dotfiles ref to bake in:" "main")" || { gum_info "Cancelled."; return 0; }

    local since; since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    gum_info "Starting the image build (ref ${ref}, dotfiles ${dref})…"
    gh workflow run "$BUILD_WF" --repo "$REPO" --ref "$ref" \
        -f dotfiles_ref="$dref" -f push=true \
        || die "Failed to start the build. Run 'gh auth status' and confirm you can dispatch workflows in ${REPO}."

    local id
    id="$(find_new_run "$BUILD_WF" "$since")" \
        || die "The build was dispatched but no run appeared within 60s. Check: https://github.com/${REPO}/actions/workflows/${BUILD_WF}"
    gum_success "Build started: $(run_url "$id")"

    local start=$SECONDS
    if gum_spin_wait "Building the image (this takes ~15-20 min)…" \
        gh run watch "$id" --repo "$REPO" --exit-status; then
        local mins=$(( (SECONDS - start) / 60 ))
        gum_box_success "Image built in ~${mins} min and published as :${IMAGE_TAG} (and the commit SHA tag)." \
            "$(run_url "$id")"
    else
        gum_error "The image build failed. Recent errors:"
        gh run view "$id" --repo "$REPO" --log-failed 2>/dev/null | tail -20
        die "See the full run: $(run_url "$id")"
    fi
}

cmd_connect() {
    preflight
    local ref; ref="$(workflow_ref)" || exit 1

    local mins
    while :; do
        mins="$(ask "Minutes to keep the session open (5-360):" "15")" || { gum_info "Cancelled."; return 0; }
        valid_minutes "$mins" && break
        gum_warning "Enter a whole number of minutes between 5 and 360."
    done

    local since; since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    gum_info "Starting a ${mins}-minute session from the '${IMAGE_TAG}' image…"
    gh workflow run "$SSH_WF" --repo "$REPO" --ref "$ref" \
        -f minutes="$mins" -f image_tag="$IMAGE_TAG" \
        || die "Could not start the session. Run 'gh auth status' and confirm you can dispatch jobs in ${REPO}. If the job workflow was only just added, give GitHub a moment to register it, then retry."

    local id
    id="$(find_new_run "$SSH_WF" "$since")" \
        || die "The session was dispatched but no run appeared within 60s. Check: https://github.com/${REPO}/actions/workflows/${SSH_WF}"
    gum_success "Session job started: $(run_url "$id")"

    await_address "$id"
    gum_box_success \
        "Your agent box is ready — a plain terminal inside the image." \
        "" \
        "  $ADDR" \
        "" \
        "  Window: ${mins} min (the job self-terminates then)." \
        "  Run:    $(run_url "$id")" \
        "  End early with:  agent-ssh kill"

    if gum_confirm "Connect now?"; then
        exec ssh -o StrictHostKeyChecking=accept-new "${ADDR#ssh }"
    fi
    gum_info "Not connecting. When you are ready:"
    print -r -- "  $ADDR"
}

# Wait for <run id>'s SSH address; sets ADDR or dies with what to check.
await_address() {
    local id="$1" rc
    gum_info "Waiting for the SSH address (up to 8 min)…"
    ADDR="$(wait_for_ssh_address "$id")"
    rc=$?
    if (( rc == 2 )); then
        die "Stopped waiting because GitHub's API could not be read. Check your connection and 'gh auth status', then inspect: $(run_url "$id")"
    elif (( rc == 3 )); then
        die "The session run completed before publishing a valid SSH address. Check: $(run_url "$id")"
    elif (( rc != 0 )) || [[ -z "$ADDR" ]]; then
        die "No valid SSH address annotation appeared within 8 min. The job may still be starting, or the image tag '${IMAGE_TAG}' is not published. Check: $(run_url "$id"). End it with: agent-ssh kill"
    fi
}

# Attaching needs a real terminal; refuse up front rather than after dispatching.
require_tty() {
    [[ -t 0 && -t 1 ]] || die "Attaching needs an interactive terminal. Run it from a terminal, or pass --no-attach and connect later with: agent-ssh attach <issue>"
}

# Menus need gum on a terminal. Without it gum_choose silently returns the first
# option, which for attach/kill would act on an arbitrary session: refuse instead.
require_choice_ui() {
    _gum_check || die "$1 needs an interactive menu, which is off here (no terminal, or NO_GUM is set). $2"
}

# Drop into the agent's live tmux session (never returns).
attach_to() {
    local issue="$1" id="$2"
    await_address "$id"
    gum_box_success \
        "Agent on issue #${issue} is running in tmux — you are about to join it." \
        "" \
        "  $ADDR" \
        "" \
        "  Run:      $(run_url "$id")" \
        "  Leave it running:  Ctrl-b d   (the agent keeps working)" \
        "  Re-attach:         agent-ssh attach ${issue}" \
        "  End the agent:     agent-ssh kill ${issue}"
    exec ssh -o StrictHostKeyChecking=accept-new "${ADDR#ssh }"
}

# One-time checks that hold for every issue in this invocation.
preflight_agent() {
    local secrets rc
    secrets="$(gh secret list --repo "$REPO" --json name --jq '.[].name' 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        die "Cannot read the secrets of ${REPO} to confirm ${AGENT_SECRET} exists: ${secrets}. You need admin access to the repo; check 'gh auth status'."
    fi
    print -r -- "$secrets" | grep -qx "$AGENT_SECRET" \
        || die "${REPO} has no ${AGENT_SECRET} secret, so the agent could not sign in to Claude. Run: claude setup-token, then: gh secret set ${AGENT_SECRET} --repo ${REPO}"
}

# Per-issue checks: the issue is open and no agent is already on it.
preflight_issue() {
    local issue="$1" state active rc
    state="$(gh issue view "$issue" --repo "$REPO" --json state --jq .state 2>&1)" \
        || die "Cannot read issue #${issue} in ${REPO}: ${state}"
    [[ "$state" == OPEN ]] \
        || die "Issue #${issue} is ${state:l}, not open. Reopen it or pick another issue."
    active="$(find_active_run "$issue")"
    rc=$?
    (( rc == 2 )) && die "Could not check for a running agent on issue #${issue} because GitHub's API failed."
    [[ -z "$active" ]] \
        || die "An agent is already running on issue #${issue}: $(run_url "$active"). Join it with: agent-ssh attach ${issue}"
}

# Dispatch one agent run; sets RUN_ID.
dispatch_agent() {
    local ref="$1" issue="$2" mins="$3" model="$4"
    local since; since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    gh workflow run "$SSH_WF" --repo "$REPO" --ref "$ref" \
        -f issue="$issue" -f minutes="$mins" -f model="$model" -f image_tag="$IMAGE_TAG" \
        || die "Could not start the agent on issue #${issue}. Run 'gh auth status' and confirm you can dispatch workflows in ${REPO}."
    RUN_ID="$(find_new_run "$SSH_WF" "$since" "$(agent_title "$issue")")" \
        || die "The agent for issue #${issue} was dispatched but no run appeared within 60s. Check: https://github.com/${REPO}/actions/workflows/${SSH_WF}"
}

# agent-ssh <issue>...: dispatch an agent per issue. A single issue attaches to it
# (unless --no-attach); several just print how to attach to each.
cmd_agents() {
    local -a issues=("$@")
    local n
    for n in "${issues[@]}"; do
        is_issue_number "$n" || die "'${n}' is not an issue number. Usage: agent-ssh <issue>... (or a subcommand: agent-ssh help)"
    done
    local -a unique=(${(u)issues})   # (not ${#${(u)issues}}: that is a string length for one element)
    (( ${#unique} == ${#issues} )) || die "The same issue was listed twice: ${issues[*]}"

    local mins="${OPT_MINUTES:-$AGENT_DEFAULT_MINUTES}" model="${OPT_MODEL:-$AGENT_DEFAULT_MODEL}"
    valid_minutes "$mins" || die "--minutes must be a whole number between 5 and 360 (got '${mins}')."

    local attach=""
    (( ${#issues} == 1 )) && [[ -z "$OPT_NO_ATTACH" ]] && attach=1
    [[ -z "$attach" ]] || require_tty

    preflight
    local ref; ref="$(workflow_ref)" || exit 1
    preflight_agent
    for n in "${issues[@]}"; do preflight_issue "$n"; done   # validate all before dispatching any

    for n in "${issues[@]}"; do
        gum_info "Starting an agent on issue #${n} (${model}, ${mins} min)…"
        dispatch_agent "$ref" "$n" "$mins" "$model"
        gum_success "Agent started on #${n}: $(run_url "$RUN_ID")"
        if [[ -n "$attach" ]]; then
            attach_to "$n" "$RUN_ID"
        fi
        gum_dim "  join it with: agent-ssh attach ${n}"
    done
}

# agent-ssh attach [issue]: join a running agent's tmux session.
cmd_attach() {
    local issue="${1:-}"
    [[ -z "$issue" ]] || is_issue_number "$issue" || die "'${issue}' is not an issue number. Usage: agent-ssh attach [issue]"
    require_tty
    preflight

    local id
    if [[ -n "$issue" ]]; then
        id="$(find_active_run "$issue")"
        case $? in
            0) ;;
            2) die "Could not list running agents because GitHub's API failed. Check 'gh auth status' and your connection." ;;
            *) die "No agent is running on issue #${issue}. Start one with: agent-ssh ${issue}" ;;
        esac
    else
        local runs rc
        runs="$(active_agent_runs)"
        rc=$?
        (( rc == 0 )) || die "Could not list running agents because GitHub's API failed. Check 'gh auth status' and your connection."
        [[ -n "$runs" ]] || die "No agents are running. Start one with: agent-ssh <issue>"
        local -a rows=("${(@f)runs}")
        if (( ${#rows} == 1 )); then
            issue="${rows[1]#*$'\t'}"
        else
            require_choice_ui "Choosing between several running agents" "Name the issue instead: agent-ssh attach <issue>"
            local row pick
            local -a labels=()
            for row in "${rows[@]}"; do labels+=("issue #${row#*$'\t'}  (run ${row%%$'\t'*})"); done
            pick="$(gum_choose --header "Which agent?" "${labels[@]}")"
            [[ -n "$pick" ]] || { gum_info "Nothing selected."; return 0; }
            issue="${${pick#issue #}%% *}"
        fi
        id="$(find_active_run "$issue")" || die "The agent on issue #${issue} finished before you could join it."
    fi
    attach_to "$issue" "$id"
}

cmd_kill() {
    local issue="${1:-}"
    [[ -z "$issue" ]] || is_issue_number "$issue" || die "'${issue}' is not an issue number. Usage: agent-ssh kill [issue]"
    preflight
    if [[ -n "$issue" ]]; then
        local id
        id="$(find_active_run "$issue")"
        case $? in
            0) ;;
            2) die "Could not list running agents because GitHub's API failed. Check 'gh auth status' and your connection." ;;
            *) die "No agent is running on issue #${issue}." ;;
        esac
        gh run cancel "$id" --repo "$REPO" \
            || die "Could not cancel the agent on issue #${issue} ($(run_url "$id")). It may have just finished."
        gum_success "Ended the agent on issue #${issue}"
        return 0
    fi
    local rows
    rows="$(gh run list --repo "$REPO" --workflow "$SSH_WF" --status in_progress \
        --json databaseId,displayTitle,createdAt \
        --jq '.[] | "\(.databaseId)  \(.displayTitle)  (\(.createdAt))"' 2>/dev/null || true)"
    if [[ -z "$rows" ]]; then
        gum_info "No SSH sessions are running."
        return 0
    fi
    require_choice_ui "Choosing which session to end" "Name the agent instead: agent-ssh kill <issue>"
    local -a items; items=("${(@f)rows}")
    local -a chosen
    chosen=("${(@f)$(gum_choose --no-limit --header "Select sessions to end:" "${items[@]}")}")
    if (( ${#chosen[@]} == 0 )); then
        gum_info "Nothing selected."
        return 0
    fi
    local line id
    for line in "${chosen[@]}"; do
        [[ -n "$line" ]] || continue
        id="${line%%  *}"
        if gh run cancel "$id" --repo "$REPO" 2>/dev/null; then
            gum_success "Ended session $id"
        else
            gum_warning "Could not end session $id (it may have already finished)."
        fi
    done
}

cmd_help() {
    cat <<'EOF'
agent-ssh - run Claude Code agents on GitHub issues, and SSH into them.

Usage:
  agent-ssh 12             Start an agent on issue #12 and join its live session.
  agent-ssh 12 13 14       Start an agent on each issue (no attach).
  agent-ssh attach [12]    Join a running agent's session (menu when no issue given).
  agent-ssh kill [12]      End the agent on issue #12 (menu when no issue given).
  agent-ssh              Open the interactive menu.
  agent-ssh connect      Start a plain terminal box (no agent) and connect.
  agent-ssh status       Show the latest published images and any running jobs.
  agent-ssh build        Build and publish a fresh image from your dotfiles.
  agent-ssh help         Show this help.

Agent flags (any position):
  -m, --minutes N      how long the agent box stays up, 5-360 (default 120)
  --model ID           Claude model the agent uses (default claude-opus-4-8)
  --no-attach          start the agent but do not join it, even for one issue

An agent works its issue on a branch named issue-<N> and opens a pull request
into dev. Leave a session running with Ctrl-b d; join it again with
'agent-ssh attach <N>'. One-time setup: claude setup-token, then
gh secret set CLAUDE_CODE_OAUTH_TOKEN --repo <repo>.

'connect' gives you a plain terminal inside the image (rustc, cargo-nextest,
just, uv, the ctx-* tools) with no agent.

Environment:
  AGENT_SSH_REPO       repo hosting the jobs   (default sophiaconsulting/cartridge)
  AGENT_SSH_REF        pin the branch the jobs run from (default: auto)
  AGENT_SSH_IMAGE_TAG  image tag to boot       (default latest)
EOF
}

cmd_menu() {
    # No menu without gum on a terminal (agent sessions, NO_GUM): show the usage.
    _gum_check || { cmd_help; return; }
    local choice
    choice="$(gum_choose --header "What would you like to do?" \
        "agent   - run an agent on an issue" \
        "attach  - join a running agent" \
        "connect - start a plain terminal box and SSH in" \
        "status  - show images and running jobs" \
        "build   - build a fresh image" \
        "kill    - end a running session" \
        "help    - show help")"
    case "$choice" in
        agent*)   local n; n="$(ask "Issue number:" "")" || return 0
                  cmd_agents "$n" ;;
        attach*)  cmd_attach ;;
        connect*) cmd_connect ;;
        status*)  cmd_status ;;
        build*)   cmd_build ;;
        kill*)    cmd_kill ;;
        help*)    cmd_help ;;
        "")       gum_info "Nothing selected." ;;
        *)        cmd_help ;;
    esac
}

# Hidden hooks for the hermetic test suite.
run_hook() {
    local hook="$1"; shift
    case "$hook" in
        __extract-ssh)       extract_ssh_address "$@" ;;
        __valid-minutes)     valid_minutes "$1" ;;
        __resolve-ref)       resolve_workflow_ref "$@" ;;
        __fetch-annotation)  fetch_ssh_annotation "$@" ;;
        __wait-annotation)   wait_for_ssh_address "$@" ;;
        __is-issue)          is_issue_number "$1" ;;
        __agent-title)       agent_title "$1" ;;
        __find-run)          find_new_run "$@" ;;
        __active-runs)       active_agent_runs ;;
        __parse-args)
            parse_args "$@" || return 1
            print -r -- "minutes=${OPT_MINUTES} model=${OPT_MODEL} no_attach=${OPT_NO_ATTACH} positional=${(j:,:)POSITIONAL}" ;;
        *) gum_error "Unknown hook: ${hook}"; return 1 ;;
    esac
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
main() {
    case "${1:-}" in
        help|-h|--help) cmd_help; return ;;
        __*)            run_hook "$@"; return ;;
    esac

    parse_args "$@" || exit 1
    local cmd="${POSITIONAL[1]:-}"
    if is_issue_number "$cmd"; then
        cmd_agents "${POSITIONAL[@]}"
        return
    fi
    case "$cmd" in
        ""|menu)      cmd_menu ;;
        connect)      cmd_connect ;;
        attach)       cmd_attach "${POSITIONAL[2]:-}" ;;
        status)       cmd_status ;;
        build)        cmd_build ;;
        kill)         cmd_kill "${POSITIONAL[2]:-}" ;;
        *)
            gum_error "Unknown command: ${cmd}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
