#!/usr/bin/env python3
# queue -- a machine-wide gate for heavy commands: at most N run at once.
#
#   queue <cmd> [args...]          wait for a free slot, then run cmd HERE
#   queue '<shell string>'         one argument = run it with `zsh -c`
#                                  (so `queue 'cd /repo && cargo nextest run'`
#                                  keeps the && inside the gated command)
#   queue --priority <cmd...>      skip the waiting line; take the next free slot
#   queue --solo <cmd...>          take EVERY slot; runs with the box to itself
#   queue --slots [N]              show, or set, the machine-wide slot count
#   queue -l | --list              who holds which slot, and who is waiting
#   queue --exit-code --last       exit code of this session's last queued job
#   queue --status --last          that job's record (command, cwd, times, rc)
#
# Python port (stdlib only) of the zsh gate; CLI and on-disk layout identical.
# The command runs as THIS process's child with live stdio, its own exit code,
# cwd and environment. The only shared state is N lock files held with flock(2)
# on file descriptors; the kernel drops a lock when its holder dies. Lock fds are
# never inherited by the child (close_fds), so a service the job leaves running
# cannot pin a slot after the job exits.
#
# FAIRNESS. Waiters take a "turnstile" lock one at a time, and only the
# turnstile holder may claim a slot; --solo holds the turnstiles while it
# collects every slot. --priority skips the turnstile.
#
# Slot count: $QUEUE_DIR/slots (machine-wide, live), seeded from QUEUE_SLOTS.
# Express (short-job) pool: $QUEUE_DIR/express, seeded from QUEUE_EXPRESS_SLOTS.
import atexit
import fcntl
import glob
import hashlib
import os
import re
import signal
import subprocess
import sys
import time

SELF = "queue"
ENV = os.environ
DIR = ENV.get("QUEUE_DIR") or f"/tmp/queue-{os.getuid()}"
STATE = ENV.get("QUEUE_STATE_DIR") or os.path.expanduser("~/.cache/queue")
HEARTBEAT = float(ENV.get("QUEUE_HEARTBEAT") or 30)
POLL = float(ENV.get("QUEUE_POLL") or 0.2)
FAST_S = float(ENV.get("QUEUE_FAST_S") or 30)
FAST_RUNS = int(ENV.get("QUEUE_FAST_RUNS") or 3)
EXPRESS_CAP_S = float(ENV.get("QUEUE_EXPRESS_CAP_S") or 60)
INT_RE = re.compile(r"[0-9]+")


def die(msg):
    print(f"{SELF}: {msg}", file=sys.stderr, flush=True)
    sys.exit(2)


def say(msg):
    if not ENV.get("QUEUE_QUIET"):
        print(f"{SELF}: {msg}", file=sys.stderr, flush=True)


def run_cmd(argv):
    """exec argv, or `zsh -c` when it is a single shell string."""
    if len(argv) == 1:
        os.execvp("zsh", ["zsh", "-c", argv[0]])
    os.execvp(argv[0], argv)


def pos_int(s):
    return bool(INT_RE.fullmatch(s)) and int(s) >= 1


def read_text(path):
    with open(path) as f:
        return f.read().rstrip("\n")


def seeded(fname, envvar, default, label_corrupt):
    path = f"{DIR}/{fname}"
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        n = ENV.get(envvar, default)
        if not pos_int(n):
            die(f"{envvar} must be a positive integer, got '{n}'")
        with open(path, "w") as f:
            f.write(n + "\n")
    n = read_text(path)
    if not pos_int(n):
        die(f"{path} is corrupt ('{n}')" + label_corrupt)
    return int(n)


def slots():
    return seeded("slots", "QUEUE_SLOTS", "1", "; fix with: queue --slots N")


def xslots():
    return seeded("express", "QUEUE_EXPRESS_SLOTS", "2", "")


def pool_size(pool):
    return xslots() if pool == "express" else slots()


def pool_file(pool):
    return f"{DIR}/{'xslot' if pool == 'express' else 'slot'}"


def open_lock(path):
    return os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o666)


def try_lock(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except OSError:
        return False


def session_id():
    if ENV.get("QUEUE_SESSION"):
        return ENV["QUEUE_SESSION"]

    def ps(field):
        r = subprocess.run(["ps", "-o", f"{field}=", "-p", str(os.getpid())],
                           capture_output=True, text=True)
        return r.stdout.replace(" ", "").strip()

    t = ps("tty")
    if t and t not in ("??", "?"):
        return "tty-" + t.replace("/", "-")
    g = ps("pgid")
    if g and g != "0":
        return f"pgid-{g}"
    return f"shell-{os.getppid()}"


def slot_busy(i):
    fd = open_lock(f"{DIR}/slot.{i}")
    try:
        return not try_lock(fd)
    finally:
        os.close(fd)


KNOWN_FILE = re.compile(r"slots|express|slots\.tmp|x?slot\.[0-9]+(\.info)?|turnstile\.(main|express)|wait\.[0-9]+")


def reap_dead_wait(path):
    """True (and unlinked) when the wait file's pid is gone."""
    try:
        os.kill(int(path.rsplit(".", 1)[1]), 0)
    except ProcessLookupError:
        pass
    except (PermissionError, ValueError):
        return False
    else:
        return False
    try:
        os.unlink(path)
    except OSError:
        pass
    return True


def prune_strays():
    """Unlink files matching no current naming scheme, only when unlocked."""
    for name in os.listdir(DIR):
        path = f"{DIR}/{name}"
        if KNOWN_FILE.fullmatch(name) or not os.path.isfile(path):
            continue
        fd = os.open(path, os.O_RDONLY)
        try:
            if try_lock(fd):
                os.unlink(path)
        finally:
            os.close(fd)


def list_():
    n = slots()
    prune_strays()
    print(f"slots: {n}  (dir: {DIR})")
    held = 0
    for i in range(1, (64 if n > 64 else n + 8) + 1):
        if not os.path.exists(f"{DIR}/slot.{i}") or not slot_busy(i):
            continue
        held += 1
        try:
            info = read_text(f"{DIR}/slot.{i}.info")
        except OSError:
            info = ""
        print(f"  slot {i}: {info or 'held (no record)'}")
    print(f"running: {held}")
    waiters = [f for f in sorted(glob.glob(f"{DIR}/wait.*")) if not reap_dead_wait(f)]
    print(f"waiting: {len(waiters)}")
    for f in waiters:
        try:
            print(f"  {read_text(f)}")
        except OSError:
            print("  ")


def norm_cmd(display):
    c = display
    pat = re.compile(r"\s*cd\s+[^&;]+(&&|;)", re.S)
    while (m := pat.match(c)):
        c = c[m.end():]
    return c.lstrip() + "\n"


def last_record(arg0, arg1):
    if arg1 != "--last":
        die(f"{arg0} needs --last")
    rec = f"{STATE}/last/{session_id()}"
    if not os.access(rec, os.R_OK):
        die(f"no queued job recorded for this session ({session_id()})")
    if arg0 == "--exit-code":
        rc = ""
        for line in open(rec).read().splitlines():
            k, _, v = line.partition("=")
            if k == "rc":
                rc = v
        if not rc:
            die(f"the last job has not finished (no rc in {rec})")
        print(rc)
        sys.exit(int(rc))
    sys.stdout.write(open(rec).read())
    sys.exit(0)


def main(argv):
    if ENV.get("QUEUE_ACTIVE"):
        while argv and argv[0].startswith("--"):
            if argv.pop(0) == "--":
                break
        if not argv:
            die("nothing to run")
        run_cmd(argv)

    try:
        os.makedirs(DIR, exist_ok=True)
        os.makedirs(f"{STATE}/last", exist_ok=True)
    except OSError:
        die(f"cannot create {DIR} or {STATE}")

    first = argv[0] if argv else ""
    if first in ("", "-h", "--help"):
        with open(os.path.realpath(__file__)) as f:
            lines = f.read().split("\n")[1:14]
        print("\n".join(re.sub(r"^# ?", "", ln) for ln in lines))
        sys.exit(0)
    if first in ("-l", "--list", "--watch"):
        list_()
        sys.exit(0)
    if first == "--slots":
        if len(argv) > 1 and argv[1]:
            if not pos_int(argv[1]):
                die(f"--slots needs a positive integer, got '{argv[1]}'")
            try:
                with open(f"{DIR}/slots.tmp", "w") as f:
                    f.write(argv[1] + "\n")
                os.replace(f"{DIR}/slots.tmp", f"{DIR}/slots")
            except OSError:
                die(f"could not write {DIR}/slots")
            print(f"{SELF}: slots -> {argv[1]} (machine-wide, live)")
        else:
            print(f"{SELF}: {slots()} slot(s)  ({DIR}/slots)")
        sys.exit(0)
    if first in ("--exit-code", "--status"):
        last_record(first, argv[1] if len(argv) > 1 else "")
    if first in ("--cancel", "--triage", "--ahead", "--depth", "--budget", "-C"):
        die(f"{first} was removed with the task-spooler daemon (2026-10-01): a waiting "
            "job is just a process -- stop it with Ctrl-C or kill <pid> (see queue -l)")

    priority = solo = 0
    while argv:
        a = argv[0]
        if a == "--priority":
            priority = 1
        elif a == "--solo":
            solo = 1
        elif a == "--":
            argv.pop(0)
            break
        elif a.startswith("--"):
            die(f"unknown option {a} (see queue --help)")
        else:
            break
        argv.pop(0)
    if not argv:
        die("nothing to run")

    display = " ".join(argv)
    rec = f"{STATE}/last/{session_id()}"
    os.makedirs(f"{STATE}/hist", exist_ok=True)
    key = hashlib.sha1(norm_cmd(display).encode()).hexdigest()[:16]
    hist = f"{STATE}/hist/{key}"

    lane = "main"
    if not solo and os.access(hist, os.R_OK):
        recent = [ln for ln in open(hist).read().splitlines()[-FAST_RUNS:]]
        if len(recent) >= FAST_RUNS and all(float(d) < FAST_S for d in recent):
            lane = "express"

    cwd = os.getcwd()
    with open(rec, "w") as f:
        f.write(f"cmd={display}\ncwd={cwd}\npid={os.getpid()}\nsolo={solo}\n"
                f"priority={priority}\nlane={lane}\nsubmitted={int(time.time())}\n")

    pid = os.getpid()
    waitf = f"{DIR}/wait.{pid}"
    clock = lambda: time.strftime("%H:%M:%S")
    with open(waitf, "w") as f:
        f.write(f"pid={pid} since={clock()} lane={lane} solo={solo} prio={priority} "
                f"cwd={cwd} cmd={display[:160]}\n")

    def rm_wait():
        try:
            os.unlink(waitf)
        except OSError:
            pass

    atexit.register(rm_wait)
    for s in (signal.SIGINT, signal.SIGTERM):
        signal.signal(s, lambda *_: sys.exit(130))

    t0 = time.monotonic()
    last_beat = t0

    def beat():
        nonlocal last_beat
        now = time.monotonic()
        if now - last_beat >= HEARTBEAT:
            last_beat = now
            say(f"still waiting {int(now - t0)}s for a {lane} slot ({pool_size(lane)}); see: queue -l")

    def wait_lock(fd):
        while not try_lock(fd):
            beat()
            time.sleep(POLL)

    held = []

    def hold(pool, i, fd):
        held.append(fd)
        with open(f"{pool_file(pool)}.{i}.info", "w") as f:
            f.write(f"pid={pid} since={clock()} lane={pool} solo={solo} cwd={cwd} cmd={display[:160]}\n")

    def claim_one(pool):
        prefix = pool_file(pool)
        while True:
            for i in range(1, pool_size(pool) + 1):
                fd = open_lock(f"{prefix}.{i}")
                if try_lock(fd):
                    hold(pool, i, fd)
                    return
                os.close(fd)
            beat()
            time.sleep(POLL)

    def claim_all(pool):
        prefix = pool_file(pool)
        for i in range(1, pool_size(pool) + 1):
            fd = open_lock(f"{prefix}.{i}")
            wait_lock(fd)
            hold(pool, i, fd)

    def take_turn(pool):
        fd = open_lock(f"{DIR}/turnstile.{pool}")
        wait_lock(fd)
        return fd

    if solo:
        tm = take_turn("main")
        tx = take_turn("express")
        claim_all("main")
        claim_all("express")
        os.close(tx)
        os.close(tm)
    elif priority:
        claim_one(lane)
    else:
        tt = take_turn(lane)
        claim_one(lane)
        os.close(tt)

    waited = int(time.monotonic() - t0)
    rm_wait()
    if waited > 0:
        say(f"got a {lane} slot after {waited}s")
    with open(rec, "a") as f:
        f.write(f"started={int(time.time())}\n")

    t_run = time.monotonic()
    child_argv = ["zsh", "-c", argv[0]] if len(argv) == 1 else argv
    try:
        child = subprocess.Popen(child_argv, close_fds=True, env={**ENV, "QUEUE_ACTIVE": "1"})
        signal.signal(signal.SIGINT, signal.SIG_IGN)  # tty ^C reaches the child directly
        signal.signal(signal.SIGTERM, lambda s, _: child.send_signal(s))
        rc = child.wait()
        rc = 128 - rc if rc < 0 else rc
    except FileNotFoundError:
        print(f"{SELF}: {argv[0]}: command not found", file=sys.stderr)
        rc = 127
    except PermissionError:
        print(f"{SELF}: {argv[0]}: permission denied", file=sys.stderr)
        rc = 126
    dur = int(time.monotonic() - t_run)

    with open(hist, "a") as f:
        f.write(f"{dur}\n")
    if lane == "express" and dur > EXPRESS_CAP_S:
        say(f"NOTE: ran {dur}s in the express lane (cap {int(EXPRESS_CAP_S)}s); "
            "this command goes to the main lane from now on")
    with open(rec, "a") as f:
        f.write(f"finished={int(time.time())}\nseconds={dur}\nrc={rc}\n")
    sys.exit(rc)


if __name__ == "__main__":
    main(sys.argv[1:])
