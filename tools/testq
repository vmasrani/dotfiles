#!/usr/bin/env zsh
# Renamed to `queue` on 2026-08-03, along with the model it implements.
#
# This is a loud gravestone rather than a symlink ON PURPOSE. The rename came
# with a behaviour change -- weighted admission became a plain slot count, and
# the PreToolUse hook stopped auto-queueing anything -- so a caller still typing
# `testq` is working from stale assumptions about what the queue DOES, not just
# from a stale name. Silently forwarding would hide exactly what they need to
# re-read. Delete this file once nothing reaches for the old name.
print -u2 "testq has been renamed to \`queue\`, and its scheduling model changed with it."
print -u2 ""
print -u2 "  testq cargo nextest run       ->  queue cargo nextest run"
print -u2 "  testq --budget                ->  queue --slots"
print -u2 "  testq --explain / --selftest  ->  gone; nothing classifies commands now"
print -u2 ""
print -u2 "Queueing is no longer automatic: the hook now DENIES an unqueued suite"
print -u2 "instead of rewriting it, so you type the prefix yourself. See 'queue --help'."
exit 127
