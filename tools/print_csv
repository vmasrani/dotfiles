#!/usr/bin/env zsh
# Pretty-print a table with column stats (DuckDB, via table-preview).
#   print_csv file.csv        any file table-preview supports
#   ... | print_csv           CSV on stdin
set -euo pipefail

(( $# )) && exec table-preview "$@"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cat >"$tmp/stdin.csv"
table-preview "$tmp/stdin.csv"
