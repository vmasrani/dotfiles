# Starter justfile. This project owns it -- edit freely.
#
# The CI contract is only the two aggregates at the bottom. Every other recipe
# here is convention: rename, split, or delete them as the project grows, as
# long as `ci-fast` and `ci-deep` keep running real checks.
#
# ── THE ONE INVARIANT THIS FILE EXISTS TO HOLD ───────────────────────────────
# A check that cannot run must FAIL, never pass. Every recipe with an external
# prerequisite -- a binary, a fixture, a built artifact, a credential -- states
# it with `_require-cmd` / `_require-file` FIRST. A recipe that shrugs at a
# missing prerequisite and exits 0 is indistinguishable from one that verified
# the code, and it stays that way until something ships broken.
#
# The same rule downstream: `#[ignore]`d tests and cfg-gated suites hide real
# coverage loss. Reconcile the test COUNT against a known baseline, and make a
# gate that CANNOT run its guarded tests say so and exit non-zero. "Skipped"
# and "passed" must never be the same observable state.
#
# Test-binary layout is part of this: more than one flat `tests/*.rs` file in
# a crate (without `autotests = false` plus a `tests/main.rs` harness) links a
# redundant multi-megabyte binary per file and multiplies nextest's
# list-before-run overhead, so `ci-fast` runs `_test-binary-layout` to fail on
# it. Every `cargo build|nextest|clippy` line reachable from `ci-fast` must
# reuse the exact same `(--features, profile, target)` tuple as `test`, since
# each distinct tuple forces a full workspace recompile.

# Fail loud when a required command is absent. Usage: `_require-cmd cargo`
_require-cmd +CMDS:
    #!/usr/bin/env bash
    set -euo pipefail
    missing=()
    for c in {{CMDS}}; do command -v "$c" >/dev/null 2>&1 || missing+=("$c"); done
    if ((${#missing[@]})); then
        printf 'MISSING PREREQUISITE: %s\n' "${missing[@]}" >&2
        printf 'These checks cannot run. Install them and re-run -- do not skip past this.\n' >&2
        exit 1
    fi

# Fail loud when a required file or directory is absent. Usage:
# `_require-file test-corpus/`
_require-file +PATHS:
    #!/usr/bin/env bash
    set -euo pipefail
    missing=()
    for p in {{PATHS}}; do [ -e "$p" ] || missing+=("$p"); done
    if ((${#missing[@]})); then
        printf 'MISSING PREREQUISITE: %s\n' "${missing[@]}" >&2
        printf 'The tests that read these would SKIP and still report success. Refusing.\n' >&2
        exit 1
    fi

# Fails loud when a workspace crate violates the one-integration-harness-per-
# crate rule (rust-gates: test-binary layout) -- more than one flat
# `tests/*.rs` file, or a flat file alongside a `tests/<suite>/main.rs`
# harness, unless the crate's Cargo.toml sets `autotests = false`.
_test-binary-layout: (_require-cmd "jq" "cargo")
    #!/usr/bin/env bash
    set -euo pipefail
    violations=0
    checked=0
    while IFS= read -r manifest; do
        [[ "$manifest" == *"/vendor/"* ]] && continue
        checked=$((checked + 1))
        dir=$(dirname "$manifest")
        crate=$(basename "$dir")
        tests_dir="$dir/tests"
        [ -d "$tests_dir" ] || continue
        if grep -qE '^\s*autotests\s*=\s*false' "$manifest"; then
            continue
        fi
        flat_count=$(find "$tests_dir" -maxdepth 1 -name '*.rs' -type f | wc -l | tr -d ' ')
        suite_mains=$(find "$tests_dir" -mindepth 2 -maxdepth 2 -name 'main.rs' -type f | wc -l | tr -d ' ')
        if (( flat_count > 1 )); then
            printf '%s: %d flat test files -- consolidate into tests/main.rs (rust-gates: test-binary layout)\n' "$crate" "$flat_count"
            violations=$((violations + 1))
        elif (( flat_count >= 1 && suite_mains >= 1 )); then
            printf '%s: flat tests/*.rs alongside tests/*/main.rs -- consolidate into tests/main.rs (rust-gates: test-binary layout)\n' "$crate"
            violations=$((violations + 1))
        fi
    done < <(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].manifest_path')
    if (( violations > 0 )); then
        printf 'test-binary-layout: %d violation(s)\n' "$violations" >&2
        exit 1
    fi
    printf 'test-binary-layout: ok (%d crates)\n' "$checked"

fmt-check:
    cargo fmt --all --check

lint:
    cargo clippy --workspace --all-targets -- -D warnings

test:
    cargo nextest run --workspace

build:
    cargo build --workspace

# Fast pre-push gate: formatting + lint, NO tests. `.githooks/pre-push` runs
# this, so keep it quick -- a slow gate is a bypassed gate.
pre-push: fmt-check lint

# Install the pre-push gate into this clone. Once per clone, per machine.
install-hooks:
    git config core.hooksPath .githooks
    @echo "git hooks active (core.hooksPath=.githooks); pre-push now runs the lint gate"

# One compile tuple per gate (rust-gates): every `cargo build|nextest|clippy`
# line below reuses the SAME (--features, profile, target) tuple as `test` --
# none add `--features`/`--release`/`--target`. A second tuple recompiles the
# whole workspace a second time. Check with `rg -n -- '--features' justfile`
# before adding one.
ci-fast: (_require-cmd "cargo") fmt-check lint _test-binary-layout test build

# Grow this as real integration/e2e suites appear.
ci-deep: ci-fast
