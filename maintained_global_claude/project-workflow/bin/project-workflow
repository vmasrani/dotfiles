#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
    local source="${BASH_SOURCE[0]}"
    local dir
    while [[ -L "$source" ]]; do
        dir="$(cd -- "$(dirname -- "$source")" && pwd)"
        source="$(readlink -- "$source")"
        [[ "$source" == /* ]] || source="$dir/$source"
    done
    cd -- "$(dirname -- "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
readonly SCRIPT_DIR
KIT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly KIT_DIR
readonly TEMPLATE_DIR="$KIT_DIR/templates"

# The CI contract is exactly what CI executes -- nothing else. Sub-recipe names
# (fmt-check, lint, test, ...) are project convention, not contract.
readonly CONTRACT_RECIPES=(ci-fast ci-deep)

# What the pre-push hook executes. Separate from CONTRACT_RECIPES because CI
# never runs it: this is the LOCAL gate, and it is the only thing standing in
# front of a direct push to dev (which the org ruleset deliberately allows).
readonly HOOK_RECIPE=pre-push

# The org that owns these repos, and the custom property whose value decides
# whether the strict main ruleset applies. See rulesets/README.md.
readonly ORG=sophiaconsulting
readonly WORKFLOW_PROPERTY=agent-workflow

# The branch `sync-policy` opens its pull request from.
readonly SYNC_BRANCH=chore/policy-sync

# Single source of truth for the files the kit owns byte-for-byte, as
# KIT-RELATIVE-SOURCE:REPO-RELATIVE-DESTINATION. `init` installs them and
# `sync-policy` re-syncs them, so the two can never drift apart.
#
# CLAUDE.md and the justfile are deliberately absent: init seeds them and the
# project then edits them, so they are per-project files, not managed copies.
readonly MANAGED_FILES=(
    "policy/AGENT_WORKFLOW.md:.agent-workflow/AGENT_WORKFLOW.md"
    "templates/pull_request_template.md:.github/pull_request_template.md"
    "templates/issue_task.md:.github/ISSUE_TEMPLATE/agent-task.md"
    "templates/ci-fast.yml:.github/workflows/agent-fast.yml"
    "templates/ci-deep.yml:.github/workflows/agent-deep.yml"
    "templates/pre-push:.githooks/pre-push"
)

# A managed file in the TARGET repo opts out of syncing by containing this exact
# substring, conventionally inside a comment:
#
#     # kit-sync: project-owned
#
# `sync-policy` then never copies over that file, so a deliberate divergence (a
# job dropped for cost, a step the project cannot run) survives a kit update
# instead of being silently clobbered. The marker lives only in the repo's copy,
# never in the kit source. The trade is permanent while it is there: that file
# stops receiving upstream template fixes until the marker is deleted.
readonly OWNERSHIP_MARKER='kit-sync: project-owned'

# The one managed file that has to stay executable after any copy.
readonly HOOK_DESTINATION=.githooks/pre-push

usage() {
    cat <<'EOF'
Usage:
  project-workflow init --dir PATH
  project-workflow check --dir PATH
  project-workflow sync-policy --dir PATH
  project-workflow gh-setup --dir PATH [--repo OWNER/REPO] [--apply]

`init` creates only missing files. It never replaces an existing project file.
`check` validates the repository-local contract without running tests: the
workflow files exist and the justfile provides `ci-fast` and `ci-deep`.
`sync-policy` byte-compares the kit-managed files against a repo that already
ran `init` and, when they differ, opens a pull request into dev that updates
them. It never merges, and it never touches CLAUDE.md or the justfile.
A managed file in the repo containing `kit-sync: project-owned` is never synced;
it is reported as skipped and stops receiving kit updates until that is removed.
`gh-setup` prints the exact gh commands by default; --apply creates labels and
applies the branch-protection settings after you have reviewed them.
EOF
}

fail() {
    printf 'project-workflow: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

project_root() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null || fail "not a Git repository: $1"
}

# gh resolves the repository from the working directory's git remote. Its -R flag
# takes OWNER/REPO, never a path, so path-scoped gh calls run here instead.
gh_in_repo() {
    local root="$1"
    shift
    (cd -- "$root" && gh "$@")
}

# MANAGED_FILES entries are SOURCE:DESTINATION; these two split them so no
# caller has to know the encoding.
managed_source() {
    printf '%s' "${1%%:*}"
}

managed_destination() {
    printf '%s' "${1#*:}"
}

# True when the repo's copy of a managed file claims ownership of itself.
is_project_owned() {
    grep -qF "$OWNERSHIP_MARKER" "$1" 2>/dev/null
}

copy_missing() {
    local source="$1"
    local destination="$2"
    if [[ -e "$destination" ]]; then
        printf 'kept existing %s\n' "$destination"
        return
    fi
    mkdir -p "$(dirname -- "$destination")"
    cp "$source" "$destination"
    printf 'created %s\n' "$destination"
}

ensure_policy_link() {
    local instruction_file="$1"
    local marker='# Agent workflow policy'
    if grep -Fqx "$marker" "$instruction_file" 2>/dev/null; then
        return
    fi
    # shellcheck disable=SC2016  # backticks are literal markdown, not a subshell
    printf '\n%s\nRead and follow `.agent-workflow/AGENT_WORKFLOW.md`; it defines the required Issue, worktree, PR, CI, and gh workflow for this project.\n' "$marker" >>"$instruction_file"
    printf 'added workflow policy link to %s\n' "$instruction_file"
}

init() {
    local directory=""
    while (($#)); do
        case "$1" in
            --dir) directory="${2:-}"; shift 2 ;;
            *) fail "unknown init argument: $1" ;;
        esac
    done
    [[ -n "$directory" ]] || fail "init requires --dir PATH"

    require_command git
    local root
    root="$(project_root "$directory")"
    copy_missing "$TEMPLATE_DIR/CLAUDE.md" "$root/CLAUDE.md"
    ensure_policy_link "$root/CLAUDE.md"
    # The hook file only ARMS the gate; `just install-hooks` points git at it.
    # Shipping the file without activating it is intentional -- core.hooksPath is
    # per-clone local config, so it cannot be committed on the user's behalf.
    local pair
    for pair in "${MANAGED_FILES[@]}"; do
        copy_missing "$KIT_DIR/$(managed_source "$pair")" "$root/$(managed_destination "$pair")"
    done
    chmod +x "$root/$HOOK_DESTINATION"
    printf "\nNext: add the ci-fast, ci-deep and pre-push recipes, run \`just install-hooks\`,\nthen \`project-workflow check --dir %s\` and review the Git diff.\n" "$root"
}

has_recipe() {
    local root="$1"
    local recipe="$2"
    (cd -- "$root" && just --list --unsorted 2>/dev/null) | awk '{print $1}' | grep -Fxq "$recipe"
}

suggested_body() {
    case "$1" in
        ci-fast) printf 'ci-fast: fmt-check lint test  # aggregate your existing fast checks' ;;
        ci-deep) printf 'ci-deep: ci-fast  # plus any real integration/e2e recipes you already have' ;;
        pre-push) printf 'pre-push: fmt-check lint  # fast LOCAL gate, no tests -- see .githooks/pre-push' ;;
    esac
}

check() {
    local directory=""
    while (($#)); do
        case "$1" in
            --dir) directory="${2:-}"; shift 2 ;;
            *) fail "unknown check argument: $1" ;;
        esac
    done
    [[ -n "$directory" ]] || fail "check requires --dir PATH"
    require_command git
    local root
    local failed=false
    root="$(project_root "$directory")"
    local required_files=("$root/CLAUDE.md")
    local pair
    for pair in "${MANAGED_FILES[@]}"; do
        required_files+=("$root/$(managed_destination "$pair")")
    done
    local file
    for file in "${required_files[@]}"; do
        if [[ ! -f "$file" ]]; then
            printf 'missing file %s\n' "${file#"$root"/}" >&2
            failed=true
        elif is_project_owned "$file"; then
            # Present and deliberately divergent is a pass: sync-policy will
            # leave it alone, which is exactly what the marker asks for.
            printf 'ok (project-owned): %s\n' "${file#"$root"/}"
        else
            printf 'ok file %s\n' "${file#"$root"/}"
        fi
    done
    # An armed hook file that git is not pointed at is the failure mode this
    # whole kit exists to prevent: it LOOKS installed and gates nothing. Report
    # it as a real failure, not a note.
    if [[ "$(git -C "$root" config --get core.hooksPath || true)" == ".githooks" ]]; then
        printf 'ok hooks core.hooksPath=.githooks\n'
    else
        # shellcheck disable=SC2016  # backticks are literal prose, not a subshell
        printf 'missing hooks core.hooksPath is not .githooks in this clone; run `just install-hooks`\n' >&2
        failed=true
    fi
    if command -v just >/dev/null 2>&1; then
        local recipe
        for recipe in "${CONTRACT_RECIPES[@]}" "$HOOK_RECIPE"; do
            if has_recipe "$root" "$recipe"; then
                printf 'ok recipe %s\n' "$recipe"
            else
                printf 'missing recipe %s; add one that aggregates this project'"'"'s own recipes, for example:\n    %s\n' \
                    "$recipe" "$(suggested_body "$recipe")" >&2
                failed=true
            fi
        done
    else
        printf 'missing command just; recipes were not inspected\n' >&2
        failed=true
    fi
    [[ "$failed" == false ]] || exit 1
}

# The canonical policy file carries `<!-- policy-version: N -->` on its first
# line. It is a label for humans reading the PR, never the sync decision: the
# byte-compare is the authority, so a missing stamp is not an error.
policy_version() {
    sed -n '1s/^<!-- policy-version: \([0-9][0-9]*\) -->$/\1/p' "$KIT_DIR/policy/AGENT_WORKFLOW.md"
}

restore_branch() {
    local root="$1"
    local branch="$2"
    git -C "$root" checkout --quiet "$branch" && return
    printf 'project-workflow: could not return to %s; run: git -C %s checkout %s\n' "$branch" "$root" "$branch" >&2
}

sync_policy() {
    local directory=""
    while (($#)); do
        case "$1" in
            --dir) directory="${2:-}"; shift 2 ;;
            *) fail "unknown sync-policy argument: $1" ;;
        esac
    done
    [[ -n "$directory" ]] || fail "sync-policy requires --dir PATH"
    require_command git
    require_command gh
    require_command cmp
    local root
    root="$(project_root "$directory")"

    # Every precondition is checked before anything is written, so a failure
    # never leaves a half-made branch behind.
    [[ -f "$root/.agent-workflow/AGENT_WORKFLOW.md" ]] ||
        fail "$root does not carry the workflow kit (.agent-workflow/AGENT_WORKFLOW.md is missing); run: project-workflow init --dir $root"
    local dirty
    dirty="$(git -C "$root" status --porcelain)"
    [[ -z "$dirty" ]] ||
        fail "$(printf 'working tree is not clean; commit or stash these first:\n%s' "$dirty")"
    gh auth status >/dev/null || fail "GitHub CLI is not authenticated; run: gh auth login"
    git -C "$root" remote get-url origin >/dev/null 2>&1 ||
        fail "no 'origin' remote in $root; add one before syncing policy"

    local -a changed=()
    local -a skipped=()
    local pair
    local destination
    for pair in "${MANAGED_FILES[@]}"; do
        destination="$(managed_destination "$pair")"
        # An existing copy that carries the ownership marker is never compared
        # and never copied over -- the divergence is the point.
        if [[ -f "$root/$destination" ]] && is_project_owned "$root/$destination"; then
            skipped+=("$destination")
            continue
        fi
        # A destination that does not exist yet is a difference, not an error:
        # it means the kit grew a managed file after this repo ran init.
        cmp -s "$KIT_DIR/$(managed_source "$pair")" "$root/$destination" 2>/dev/null || changed+=("$pair")
    done
    # Skips are reported before any early return, so a repo that opts a file out
    # can never quietly look like a repo the kit still owns end to end.
    if ((${#skipped[@]} > 0)); then
        for destination in "${skipped[@]}"; do
            printf 'skipped (project-owned): %s\n' "$destination"
        done
    fi
    if ((${#changed[@]} == 0)); then
        if ((${#skipped[@]} > 0)); then
            printf 'up to date: %d of %d kit-managed files in %s match the kit; %d project-owned (skipped)\n' \
                "$((${#MANAGED_FILES[@]} - ${#skipped[@]}))" "${#MANAGED_FILES[@]}" "$root" "${#skipped[@]}"
        else
            printf 'up to date: all %d kit-managed files in %s already match the kit\n' "${#MANAGED_FILES[@]}" "$root"
        fi
        return
    fi

    git -C "$root" fetch --quiet origin || fail "git fetch origin failed in $root"
    git -C "$root" rev-parse --verify --quiet refs/remotes/origin/dev >/dev/null ||
        fail "origin has no dev branch; sync-policy targets dev, so create it before syncing"
    ! git -C "$root" rev-parse --verify --quiet "refs/heads/$SYNC_BRANCH" >/dev/null ||
        fail "local branch $SYNC_BRANCH already exists; merge or delete the stale sync branch first"
    ! git -C "$root" rev-parse --verify --quiet "refs/remotes/origin/$SYNC_BRANCH" >/dev/null ||
        fail "origin/$SYNC_BRANCH already exists; merge or delete the stale sync branch first"

    local starting_branch
    starting_branch="$(git -C "$root" rev-parse --abbrev-ref HEAD)"
    git -C "$root" checkout --quiet -b "$SYNC_BRANCH" origin/dev ||
        fail "could not create $SYNC_BRANCH from origin/dev in $root"
    # From here on the checkout is ours, so put the user back on their branch
    # however this run ends -- including the fail-loud exits below.
    # shellcheck disable=SC2064  # expand root/starting_branch now, not at exit
    trap "restore_branch '$root' '$starting_branch'" EXIT

    local -a changed_destinations=()
    for pair in "${changed[@]}"; do
        destination="$(managed_destination "$pair")"
        changed_destinations+=("$destination")
        mkdir -p "$(dirname -- "$root/$destination")"
        cp "$KIT_DIR/$(managed_source "$pair")" "$root/$destination"
        printf 'updated %s\n' "$destination"
    done
    chmod +x "$root/$HOOK_DESTINATION"

    local version
    local message='chore: sync workflow-kit managed files'
    local title="$message"
    version="$(policy_version)"
    [[ -z "$version" ]] || title="$message (policy v$version)"

    local body="Propagates the current workflow-kit files into this repository."$'\n\n'"Updated files:"$'\n'
    for destination in "${changed_destinations[@]}"; do
        body+="- \`$destination\`"$'\n'
    done
    if ((${#skipped[@]} > 0)); then
        body+=$'\nNot synced -- these carry the `kit-sync: project-owned` marker:\n'
        for destination in "${skipped[@]}"; do
            body+="- \`$destination\`"$'\n'
        done
    fi
    body+=$'\nOpened by `project-workflow sync-policy`. Only files the kit owns byte-for-byte\nare touched; CLAUDE.md and the justfile are project-owned and were not changed.\n'

    git -C "$root" add -- "${changed_destinations[@]}" || fail "git add failed in $root"
    git -C "$root" commit --quiet -m "$message" || fail "git commit failed in $root"
    git -C "$root" push --quiet -u origin "$SYNC_BRANCH" || fail "git push failed for $SYNC_BRANCH"
    local pr_url
    pr_url="$(gh_in_repo "$root" pr create --base dev --head "$SYNC_BRANCH" --title "$title" --body "$body")" ||
        fail "gh pr create failed for $SYNC_BRANCH"
    printf '\nopened %s\nReview and merge it yourself; sync-policy never merges.\n' "$pr_url"
}

gh_setup() {
    local directory=""
    local repository=""
    local apply=false
    while (($#)); do
        case "$1" in
            --dir) directory="${2:-}"; shift 2 ;;
            --repo) repository="${2:-}"; shift 2 ;;
            --apply) apply=true; shift ;;
            *) fail "unknown gh-setup argument: $1" ;;
        esac
    done
    [[ -n "$directory" ]] || fail "gh-setup requires --dir PATH"
    require_command git
    require_command gh
    local root
    root="$(project_root "$directory")"
    if [[ -z "$repository" ]]; then
        repository="$(gh_in_repo "$root" repo view --json nameWithOwner --jq .nameWithOwner)"
    fi
    gh auth status >/dev/null || fail "GitHub CLI is not authenticated"
    if [[ "$apply" == false ]]; then
        cat <<EOF
Review and then run:
  project-workflow gh-setup --dir $root --repo $repository --apply

This creates the task labels and opts the repo into the strict main ruleset by
setting the '$WORKFLOW_PROPERTY' custom property to true.

Branch rules themselves are NOT set here. They live once, at the org level, and
already cover every repo including ones that do not exist yet:
  baseline-history-protection  all repos, main/master/dev: no force-push, no delete
  agent-workflow-main-strict   opted-in repos, main: PR + green Deep integration checks
dev deliberately has NO required checks, so direct pushes to it keep working;
the local .githooks/pre-push gate is what guards that path. See rulesets/README.md.
EOF
        return
    fi
    gh label create task --color 0E8A16 --description 'Agent-owned implementation task' --force -R "$repository"
    gh label create handoff --color 5319E7 --description 'Needs another session to continue' --force -R "$repository"
    gh label create blocked --color B60205 --description 'Blocked on an external decision or state' --force -R "$repository"
    gh label create fast-lane --color FBCA04 --description 'Pre-triaged mechanical issue; eligible for batching 2-4 per PR' --force -R "$repository"

    # Opting in is a single property flip. This is the whole per-repo protection
    # step now -- the rules are already defined org-wide and match on this value.
    # -f (not -F) on the value: the property is value_type=true_false, whose
    # wire representation is the STRING "true". -F coerces true to a JSON
    # boolean and the API rejects it with 422 "Data type must be one of:
    # string, array".
    gh api --method PATCH "orgs/$ORG/properties/values" \
        -f "repository_names[]=${repository#*/}" \
        -f "properties[][property_name]=$WORKFLOW_PROPERTY" \
        -f 'properties[][value]=true'

    # A ruleset that returned 201 is not a ruleset that applies. Show what
    # GitHub says is actually in force on main, so a targeting mistake surfaces
    # here rather than as an unmergeable PR weeks later.
    printf '\nRules now in force on main for %s:\n' "$repository"
    gh ruleset check main --repo "$repository" || true
    printf '\nConfigured labels for %s and opted it into %s.\n' "$repository" "$WORKFLOW_PROPERTY"
}

main() {
    [[ $# -gt 0 ]] || { usage; exit 1; }
    local command="$1"
    shift
    case "$command" in
        init) init "$@" ;;
        check) check "$@" ;;
        sync-policy) sync_policy "$@" ;;
        gh-setup) gh_setup "$@" ;;
        -h|--help|help) usage ;;
        *) fail "unknown command: $command" ;;
    esac
}

main "$@"
