#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
    local source="${BASH_SOURCE[0]}"
    local dir
    while [[ -L "$source" ]]; do
        dir="$(cd -- "$(dirname -- "$source")" && pwd)"
        source="$(readlink -- "$source")"
        [[ "$source" == /* ]] || source="$dir/$source"
    done
    cd -- "$(dirname -- "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
readonly SCRIPT_DIR
KIT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly KIT_DIR
readonly TEMPLATE_DIR="$KIT_DIR/templates"

# The CI contract is exactly what CI executes -- nothing else. Sub-recipe names
# (fmt-check, lint, test, ...) are project convention, not contract.
readonly CONTRACT_RECIPES=(ci-fast ci-deep)

# What the pre-push hook executes. Separate from CONTRACT_RECIPES because CI
# never runs it: this is the LOCAL gate, and it is the only thing standing in
# front of a direct push to dev (which the org ruleset deliberately allows).
readonly HOOK_RECIPE=pre-push

# The org that owns these repos, and the custom property whose value decides
# whether the strict main ruleset applies. See rulesets/README.md.
readonly ORG=sophiaconsulting
readonly WORKFLOW_PROPERTY=agent-workflow

# The branch `sync-policy` opens its pull request from.
readonly SYNC_BRANCH=chore/policy-sync

# Single source of truth for the files the kit owns byte-for-byte, as
# KIT-RELATIVE-SOURCE:REPO-RELATIVE-DESTINATION. `init` installs them and
# `sync-policy` re-syncs them, so the two can never drift apart.
#
# CLAUDE.md and the justfile are deliberately absent: init seeds them and the
# project then edits them, so they are per-project files, not managed copies.
readonly MANAGED_FILES=(
    "policy/AGENT_WORKFLOW.md:.agent-workflow/AGENT_WORKFLOW.md"
    "templates/pull_request_template.md:.github/pull_request_template.md"
    "templates/issue_task.md:.github/ISSUE_TEMPLATE/agent-task.md"
    "templates/ci-fast.yml:.github/workflows/agent-fast.yml"
    "templates/ci.yml:.ci/ci.yml"
    "templates/ci.yml:.github/workflows/ci.yml"
    "templates/ci-init.sh:.ci/init.sh"
    "templates/pre-push:.githooks/pre-push"
    "templates/tools/hydrate-worktree.sh:.agent-workflow/tools/hydrate-worktree.sh"
    "templates/tools/README.md:.agent-workflow/tools/README.md"
)

# A managed file in the TARGET repo opts out of syncing by containing this exact
# substring, conventionally inside a comment:
#
#     # kit-sync: project-owned
#
# `sync-policy` then never copies over that file, so a deliberate divergence (a
# job dropped for cost, a step the project cannot run) survives a kit update
# instead of being silently clobbered. The marker lives only in the repo's copy,
# never in the kit source. The trade is permanent while it is there: that file
# stops receiving upstream template fixes until the marker is deleted.
readonly OWNERSHIP_MARKER='kit-sync: project-owned'

# The one managed file that has to stay executable after any copy.
readonly HOOK_DESTINATION=.githooks/pre-push

usage() {
    cat <<'EOF'
Usage:
  project-workflow init --dir PATH
  project-workflow check --dir PATH
  project-workflow sync-policy --dir PATH [--adopt REPO-RELATIVE-PATH]...
  project-workflow gh-setup --dir PATH [--repo OWNER/REPO] [--apply]

`init` creates only missing files. It never replaces an existing project file.
`check` validates the repository-local contract without running tests: the
workflow files exist and the justfile provides `ci-fast` and `ci-deep`.
`sync-policy` byte-compares the kit-managed files against a repo that already
ran `init` and, when they differ, opens a pull request into dev that updates
them. It never merges, and it never touches CLAUDE.md or the justfile.
A managed file in the repo containing `kit-sync: project-owned` is never synced;
it is reported as skipped and stops receiving kit updates until that is removed.
`--adopt PATH` (repeatable) resolves ONE adoption conflict by taking the kit
version: the repo's copy is overwritten and the path is recorded as kit-owned.
It is YOUR ATTESTATION that the file is stale kit lineage -- installed by the
kit, never hand-edited -- verified by you in the repo's Git history. This tool
does not and cannot check that. It errors if PATH is not a kit-managed
destination, or is not currently in the adoption-conflict state.
`gh-setup` prints the exact gh commands by default; --apply creates labels and
applies the branch-protection settings after you have reviewed them.
EOF
}

fail() {
    printf 'project-workflow: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

project_root() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null || fail "not a Git repository: $1"
}

# gh resolves the repository from the working directory's git remote. Its -R flag
# takes OWNER/REPO, never a path, so path-scoped gh calls run here instead.
gh_in_repo() {
    local root="$1"
    shift
    (cd -- "$root" && gh "$@")
}

# MANAGED_FILES entries are SOURCE:DESTINATION; these two split them so no
# caller has to know the encoding.
managed_source() {
    printf '%s' "${1%%:*}"
}

managed_destination() {
    printf '%s' "${1#*:}"
}

# Every destination the kit owns, one indented line each. Printed when --adopt
# names something that is not managed, so the operator sees the whole valid set
# instead of guessing at a spelling.
managed_destinations() {
    local pair
    for pair in "${MANAGED_FILES[@]}"; do
        printf '  %s\n' "$(managed_destination "$pair")"
    done
}

is_managed_destination() {
    local candidate="$1" pair
    for pair in "${MANAGED_FILES[@]}"; do
        [[ "$(managed_destination "$pair")" == "$candidate" ]] && return 0
    done
    return 1
}

# Bash 3.2 (what macOS ships) has no associative arrays, so membership is a
# loop. The needle comes first because "${array[@]}" has to be the last argument.
# Callers guard with a length check: "${empty[@]}" is an unbound-variable error
# under `set -u` in that bash.
contains() {
    local needle="$1" item
    shift
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

# True when the repo's copy of a managed file claims ownership of itself.
is_project_owned() {
    grep -qF "$OWNERSHIP_MARKER" "$1" 2>/dev/null
}

# Paths the kit managed BEFORE it began recording adoptions, and which a repo
# is therefore treated as having adopted even with no manifest entry.
#
# The list is deliberately SHORT, and the two workflow ymls are deliberately
# NOT on it. Grandfathering a path means "a difference here is staleness, so
# overwrite it" -- which is right only for files no project ever edits. It is
# wrong for `.github/workflows/agent-*.yml`: projects add real per-project steps
# to those (a dependency install step was clobbered exactly this way), and
# grandfathering made that loss look like a routine policy bump. They now go
# through the normal adoption path: byte-identical auto-adopts, anything else is
# a conflict the human resolves.
#
# What stays, and why removing it would false-positive: each of these is
# kit-authored end to end and is EXPECTED to be stale in every existing repo --
# `AGENT_WORKFLOW.md` carries a policy-version stamp that this tool exists to
# bump, and the PR/issue templates and pre-push hook are copied verbatim and
# never hand-edited. Requiring adoption for them would turn every first sync
# into a conflict report about files nobody touched.
#
# Never add to this list: new managed paths are adopted explicitly.
readonly LEGACY_MANAGED=(
    ".agent-workflow/AGENT_WORKFLOW.md"
    ".github/pull_request_template.md"
    ".github/ISSUE_TEMPLATE/agent-task.md"
    ".githooks/pre-push"
)
readonly ADOPTION_MANIFEST=".agent-workflow/.kit-manifest"

# True when this repo has agreed to let the kit own this path. `init` and
# `sync-policy` record every path they write; anything else at a managed path
# was authored by the project and must not be overwritten on the kit's say-so.
kit_has_adopted() {
    local root="$1" path="$2" legacy
    if [[ -f "$root/$ADOPTION_MANIFEST" ]]; then
        grep -qxF "$path" "$root/$ADOPTION_MANIFEST" && return 0
    fi
    for legacy in "${LEGACY_MANAGED[@]}"; do
        [[ "$path" == "$legacy" ]] && return 0
    done
    return 1
}

# Append a path to the adoption record, idempotently.
record_adoption() {
    local root="$1" path="$2"
    mkdir -p "$(dirname -- "$root/$ADOPTION_MANIFEST")"
    if [[ ! -f "$root/$ADOPTION_MANIFEST" ]]; then
        printf '# Paths this repository has adopted from the workflow kit.\n' >"$root/$ADOPTION_MANIFEST"
        printf '# sync-policy may update these in place; it refuses to overwrite anything else.\n' >>"$root/$ADOPTION_MANIFEST"
    fi
    grep -qxF "$path" "$root/$ADOPTION_MANIFEST" || printf '%s\n' "$path" >>"$root/$ADOPTION_MANIFEST"
}

# The adoption record is only load-bearing if it travels with the repository: a
# manifest that stays untracked is invisible in every fresh clone, so the next
# sync there re-derives adoptions from nothing and reports conflicts on files
# this run already adopted. Stage it as soon as it is written.
stage_manifest() {
    local root="$1"
    [[ -f "$root/$ADOPTION_MANIFEST" ]] || return 0
    git -C "$root" add -- "$ADOPTION_MANIFEST" ||
        fail "could not stage $ADOPTION_MANIFEST in $root; add and commit it by hand before syncing policy"
}

# True when the manifest's bytes differ from what git has recorded (including
# "not recorded at all"). Used so a sync PR never claims to update a file it
# left untouched.
manifest_is_dirty() {
    local root="$1"
    [[ -n "$(git -C "$root" status --porcelain -- "$ADOPTION_MANIFEST")" ]]
}

# Managed files include shell scripts. A vendored script copied without its
# executable bit fails at the call site with "permission denied" -- far from the
# copy that caused it -- so mirror the kit's mode rather than special-casing
# each executable by name.
mirror_exec_bit() {
    local source="$1" destination="$2"
    [[ -x "$source" ]] && chmod +x "$destination"
    return 0
}

copy_missing() {
    local source="$1"
    local destination="$2"
    if [[ -e "$destination" ]]; then
        printf 'kept existing %s\n' "$destination"
        return
    fi
    mkdir -p "$(dirname -- "$destination")"
    cp "$source" "$destination"
    mirror_exec_bit "$source" "$destination"
    printf 'created %s\n' "$destination"
}

ensure_policy_link() {
    local instruction_file="$1"
    local marker='# Agent workflow policy'
    if grep -Fqx "$marker" "$instruction_file" 2>/dev/null; then
        return
    fi
    # shellcheck disable=SC2016  # backticks are literal markdown, not a subshell
    printf '\n%s\nRead and follow `.agent-workflow/AGENT_WORKFLOW.md`; it defines the required Issue, worktree, PR, CI, and gh workflow for this project.\n' "$marker" >>"$instruction_file"
    printf 'added workflow policy link to %s\n' "$instruction_file"
}

init() {
    local directory=""
    while (($#)); do
        case "$1" in
            --dir) directory="${2:-}"; shift 2 ;;
            *) fail "unknown init argument: $1" ;;
        esac
    done
    [[ -n "$directory" ]] || fail "init requires --dir PATH"

    require_command git
    local root
    root="$(project_root "$directory")"
    copy_missing "$TEMPLATE_DIR/CLAUDE.md" "$root/CLAUDE.md"
    ensure_policy_link "$root/CLAUDE.md"
    # The hook file only ARMS the gate; `just install-hooks` points git at it.
    # Shipping the file without activating it is intentional -- core.hooksPath is
    # per-clone local config, so it cannot be committed on the user's behalf.
    local pair
    for pair in "${MANAGED_FILES[@]}"; do
        copy_missing "$KIT_DIR/$(managed_source "$pair")" "$root/$(managed_destination "$pair")"
        # Record only what the kit actually placed. `copy_missing` keeps an
        # existing project file untouched, and a path the kit did not write is a
        # path it has not been given, so it must not be recorded as adopted.
        [[ -f "$root/$(managed_destination "$pair")" ]] &&
            cmp -s "$KIT_DIR/$(managed_source "$pair")" "$root/$(managed_destination "$pair")" &&
            record_adoption "$root" "$(managed_destination "$pair")"
    done
    chmod +x "$root/$HOOK_DESTINATION"
    stage_manifest "$root"
    printf "\nNext: add the ci-fast, ci-deep and pre-push recipes, run \`just install-hooks\`,\nthen \`project-workflow check --dir %s\` and review the Git diff.\nCommit %s along with the rest -- it is the record of which files this repo\nlet the kit own, and sync-policy refuses to overwrite anything not in it.\n" \
        "$root" "$ADOPTION_MANIFEST"
}

has_recipe() {
    local root="$1"
    local recipe="$2"
    (cd -- "$root" && just --list --unsorted 2>/dev/null) | awk '{print $1}' | grep -Fxq "$recipe"
}

suggested_body() {
    case "$1" in
        ci-fast) printf 'ci-fast: fmt-check lint test  # aggregate your existing fast checks' ;;
        ci-deep) printf 'ci-deep: ci-fast  # plus any real integration/e2e recipes you already have' ;;
        pre-push) printf 'pre-push: fmt-check lint  # fast LOCAL gate, no tests -- see .githooks/pre-push' ;;
    esac
}

check() {
    local directory=""
    while (($#)); do
        case "$1" in
            --dir) directory="${2:-}"; shift 2 ;;
            *) fail "unknown check argument: $1" ;;
        esac
    done
    [[ -n "$directory" ]] || fail "check requires --dir PATH"
    require_command git
    local root
    local failed=false
    root="$(project_root "$directory")"
    # CLAUDE.md is not a managed path -- init seeds it and the project owns it
    # from then on -- so its absence is always a failure, never an adoption
    # question. The managed paths are checked against the adoption record below.
    local required_files=("$root/CLAUDE.md")
    local pair
    for pair in "${MANAGED_FILES[@]}"; do
        required_files+=("$root/$(managed_destination "$pair")")
    done
    local file relative
    for file in "${required_files[@]}"; do
        relative="${file#"$root"/}"
        if [[ ! -f "$file" ]]; then
            # A managed path missing from BOTH the disk and the adoption record
            # is a path the kit grew after this repo last synced. That is a real
            # state with a named next action, not a broken repo -- failing here
            # would red every existing repo the moment the kit adds a file, and
            # `/start-task` runs this as preflight. It is reported loudly and
            # distinctly so it can never read as "ok". A path the repo HAS
            # adopted and then lost is still a hard failure: something deleted a
            # file this repo agreed the kit owns.
            if [[ "$relative" != "CLAUDE.md" ]] && ! kit_has_adopted "$root" "$relative"; then
                # shellcheck disable=SC2016  # backticks are literal prose, not a subshell
                printf 'pending adoption %s; the kit added it after this repo last synced -- run `project-workflow sync-policy --dir %s`\n' \
                    "$relative" "$root"
                continue
            fi
            printf 'missing file %s\n' "$relative" >&2
            failed=true
        elif is_project_owned "$file"; then
            # Present and deliberately divergent is a pass: sync-policy will
            # leave it alone, which is exactly what the marker asks for.
            printf 'ok (project-owned): %s\n' "${file#"$root"/}"
        else
            printf 'ok file %s\n' "${file#"$root"/}"
        fi
    done
    # An armed hook file that git is not pointed at is the failure mode this
    # whole kit exists to prevent: it LOOKS installed and gates nothing. Report
    # it as a real failure, not a note.
    if [[ "$(git -C "$root" config --get core.hooksPath || true)" == ".githooks" ]]; then
        printf 'ok hooks core.hooksPath=.githooks\n'
    else
        # shellcheck disable=SC2016  # backticks are literal prose, not a subshell
        printf 'missing hooks core.hooksPath is not .githooks in this clone; run `just install-hooks`\n' >&2
        failed=true
    fi
    if command -v just >/dev/null 2>&1; then
        local recipe
        for recipe in "${CONTRACT_RECIPES[@]}" "$HOOK_RECIPE"; do
            if has_recipe "$root" "$recipe"; then
                printf 'ok recipe %s\n' "$recipe"
            else
                printf 'missing recipe %s; add one that aggregates this project'"'"'s own recipes, for example:\n    %s\n' \
                    "$recipe" "$(suggested_body "$recipe")" >&2
                failed=true
            fi
        done
    else
        printf 'missing command just; recipes were not inspected\n' >&2
        failed=true
    fi
    [[ "$failed" == false ]] || exit 1
}

# The canonical policy file carries `<!-- policy-version: N -->` on its first
# line. It is a label for humans reading the PR, never the sync decision: the
# byte-compare is the authority, so a missing stamp is not an error.
policy_version() {
    sed -n '1s/^<!-- policy-version: \([0-9][0-9]*\) -->$/\1/p' "$KIT_DIR/policy/AGENT_WORKFLOW.md"
}

restore_branch() {
    local root="$1"
    local branch="$2"
    git -C "$root" checkout --quiet "$branch" && return
    printf 'project-workflow: could not return to %s; run: git -C %s checkout %s\n' "$branch" "$root" "$branch" >&2
}

sync_policy() {
    local directory=""
    # Paths the operator has attested are stale kit lineage. See the --adopt
    # block below the conflict scan for what the attestation buys and costs.
    local -a adopt_requests=()
    while (($#)); do
        case "$1" in
            --dir) directory="${2:-}"; shift 2 ;;
            --adopt)
                [[ -n "${2:-}" ]] || fail "--adopt requires a repo-relative path"
                adopt_requests+=("$2")
                shift 2
                ;;
            *) fail "unknown sync-policy argument: $1" ;;
        esac
    done
    [[ -n "$directory" ]] || fail "sync-policy requires --dir PATH"
    # A misspelled --adopt is caught before any git work: an unknown path could
    # otherwise sit there looking accepted while the file it meant to resolve
    # still reports as a conflict.
    local requested
    if ((${#adopt_requests[@]} > 0)); then
        for requested in "${adopt_requests[@]}"; do
            is_managed_destination "$requested" ||
                fail "$(printf -- '--adopt %s is not a kit-managed path. Valid destinations:\n%s' \
                    "$requested" "$(managed_destinations)")"
        done
    fi
    require_command git
    require_command gh
    require_command cmp
    local root
    root="$(project_root "$directory")"

    # Every precondition is checked before anything is written, so a failure
    # never leaves a half-made branch behind.
    [[ -f "$root/.agent-workflow/AGENT_WORKFLOW.md" ]] ||
        fail "$root does not carry the workflow kit (.agent-workflow/AGENT_WORKFLOW.md is missing); run: project-workflow init --dir $root"
    local dirty
    dirty="$(git -C "$root" status --porcelain)"
    [[ -z "$dirty" ]] ||
        fail "$(printf 'working tree is not clean; commit or stash these first:\n%s' "$dirty")"
    gh auth status >/dev/null || fail "GitHub CLI is not authenticated; run: gh auth login"
    git -C "$root" remote get-url origin >/dev/null 2>&1 ||
        fail "no 'origin' remote in $root; add one before syncing policy"

    local -a changed=()
    local -a skipped=()
    local -a conflicts=()
    local -a auto_adopted=()
    local -a operator_adopted=()
    local pair
    local destination
    local source
    for pair in "${MANAGED_FILES[@]}"; do
        destination="$(managed_destination "$pair")"
        source="$KIT_DIR/$(managed_source "$pair")"
        # An existing copy that carries the ownership marker is never compared
        # and never copied over -- the divergence is the point.
        if [[ -f "$root/$destination" ]] && is_project_owned "$root/$destination"; then
            skipped+=("$destination")
            continue
        fi
        # ADOPTION. When the kit ADDS a path to MANAGED_FILES, a repo that
        # already had its own file there would be silently overwritten by the
        # next sync -- the repo loses project-specific content it never agreed
        # to hand over, and the loss looks like a routine policy bump. That has
        # already happened once (a policy sync clobbered a workflow's install
        # step), so the decision is made per file, on bytes:
        #
        #   byte-identical to the kit source -> nothing of the project's can be
        #     lost by adopting it, so adopt it silently and carry on. This is
        #     the common case for a repo that installed the file from this same
        #     kit and never touched it.
        #   different, and never adopted     -> CONFLICT. Reported and skipped,
        #     never overwritten. This is the branch the workflow ymls now reach
        #     when a project has edited them (see LEGACY_MANAGED).
        #   different, but adopted           -> a normal kit update; sync it.
        #   different, never adopted, named by --adopt -> the operator has read
        #     this file's Git history and attested the difference is kit
        #     STALENESS, not project content. Overwrite it with the kit source
        #     and record it, exactly as for an adopted file. The attestation is
        #     the operator's; nothing here verifies it, which is why it has to
        #     be spelled out per path on the command line rather than being a
        #     blanket --force.
        if [[ -f "$root/$destination" ]] && ! kit_has_adopted "$root" "$destination"; then
            if cmp -s "$source" "$root/$destination"; then
                auto_adopted+=("$destination")
            elif ((${#adopt_requests[@]} > 0)) && contains "$destination" "${adopt_requests[@]}"; then
                # Falls through to the normal byte-compare below: the bytes
                # differ, so this lands in `changed` and is copied and recorded
                # like any other synced file. The array only exists so the run
                # output and the PR body can say it was an operator decision.
                operator_adopted+=("$destination")
            else
                conflicts+=("$destination")
                continue
            fi
        fi
        # A destination that does not exist yet is a difference, not an error:
        # it means the kit grew a managed file after this repo ran init.
        cmp -s "$source" "$root/$destination" 2>/dev/null || changed+=("$pair")
    done
    # A --adopt that resolved nothing is fatal, and it is checked BEFORE the
    # conflict report so a stale invocation is corrected first. The flag grants
    # permission to overwrite a file; letting it succeed as a no-op would mean a
    # copy-pasted command line keeps claiming to resolve a conflict long after
    # that conflict is gone, and the operator never learns the state changed.
    if ((${#adopt_requests[@]} > 0)); then
        local -a unresolved_adopts=()
        for requested in "${adopt_requests[@]}"; do
            if ((${#operator_adopted[@]} > 0)) && contains "$requested" "${operator_adopted[@]}"; then
                continue
            fi
            unresolved_adopts+=("$requested")
        done
        if ((${#unresolved_adopts[@]} > 0)); then
            printf -- '--adopt named %d path(s) that are not in the adoption-conflict state:\n' \
                "${#unresolved_adopts[@]}" >&2
            for requested in "${unresolved_adopts[@]}"; do
                printf '  %s\n' "$requested" >&2
            done
            # shellcheck disable=SC2016  # backticks are literal prose, not a subshell
            printf -- '\n--adopt resolves only a file that EXISTS in the repo, DIFFERS from the kit\nsource, and is not already recorded in %s. A path that is\nalready adopted, byte-identical to the kit, absent, or carrying the\n`%s` marker needs no flag: drop --adopt for it.\n' \
                "$ADOPTION_MANIFEST" "$OWNERSHIP_MARKER" >&2
            fail "drop the --adopt flags listed above, then re-run sync-policy"
        fi
    fi
    # Conflicts are fatal and reported in full: a sync that silently declined to
    # update some files would be the same "reported success while doing nothing"
    # defect the kit exists to stamp out.
    if ((${#conflicts[@]} > 0)); then
        printf 'ADOPTION CONFLICT -- the kit now manages paths this repo already owns:\n' >&2
        for destination in "${conflicts[@]}"; do
            printf '  %s\n' "$destination" >&2
        done
        printf '\nNothing was overwritten. For each file, choose one:\n' >&2
        printf '  keep yours   -- add the ownership marker (see project-workflow/README.md) in a comment\n' >&2
        printf '  migrate      -- port your content onto the kit version in a normal PR first\n' >&2
        # Deleting the file and re-running cannot work and is deliberately not
        # offered: deleting a TRACKED file dirties the tree, and the clean-tree
        # precondition above then refuses to run at all.
        printf '  take the kit -- re-run with --adopt PATH for each file you have VERIFIED in this\n' >&2
        printf '                  repo'"'"'s Git history to be untouched kit lineage (installed by the\n' >&2
        printf '                  kit, never hand-edited). It is overwritten with the kit version.\n' >&2
        printf '                  --adopt is YOUR attestation; this tool does not check history:\n' >&2
        for destination in "${conflicts[@]}"; do
            printf '                    --adopt %s\n' "$destination" >&2
        done
        fail "resolve the conflicts above, then re-run sync-policy"
    fi
    # Skips are reported before any early return, so a repo that opts a file out
    # can never quietly look like a repo the kit still owns end to end.
    if ((${#skipped[@]} > 0)); then
        for destination in "${skipped[@]}"; do
            printf 'skipped (project-owned): %s\n' "$destination"
        done
    fi
    # Files adopted on byte-equality are announced, never silent: the repo is
    # handing the kit permission to overwrite them from now on, and that belongs
    # in the run's output as well as in the manifest.
    if ((${#auto_adopted[@]} > 0)); then
        for destination in "${auto_adopted[@]}"; do
            printf 'adopted (identical to the kit): %s\n' "$destination"
        done
    fi
    # Nothing to copy AND nothing new to record is the only up-to-date state.
    # With adoptions pending there is still a real change to land -- the record
    # itself -- and skipping it would leave the guard re-deriving the same
    # adoptions forever, which is how a hand-edited file gets clobbered once the
    # kit next changes it.
    if ((${#changed[@]} == 0 && ${#auto_adopted[@]} == 0)); then
        if ((${#skipped[@]} > 0)); then
            printf 'up to date: %d of %d kit-managed files in %s match the kit; %d project-owned (skipped)\n' \
                "$((${#MANAGED_FILES[@]} - ${#skipped[@]}))" "${#MANAGED_FILES[@]}" "$root" "${#skipped[@]}"
        else
            printf 'up to date: all %d kit-managed files in %s already match the kit\n' "${#MANAGED_FILES[@]}" "$root"
        fi
        return
    fi

    git -C "$root" fetch --quiet origin || fail "git fetch origin failed in $root"
    git -C "$root" rev-parse --verify --quiet refs/remotes/origin/dev >/dev/null ||
        fail "origin has no dev branch; sync-policy targets dev, so create it before syncing"
    ! git -C "$root" rev-parse --verify --quiet "refs/heads/$SYNC_BRANCH" >/dev/null ||
        fail "local branch $SYNC_BRANCH already exists; merge or delete the stale sync branch first"
    ! git -C "$root" rev-parse --verify --quiet "refs/remotes/origin/$SYNC_BRANCH" >/dev/null ||
        fail "origin/$SYNC_BRANCH already exists; merge or delete the stale sync branch first"

    local starting_branch
    starting_branch="$(git -C "$root" rev-parse --abbrev-ref HEAD)"
    git -C "$root" checkout --quiet -b "$SYNC_BRANCH" origin/dev ||
        fail "could not create $SYNC_BRANCH from origin/dev in $root"
    # From here on the checkout is ours, so put the user back on their branch
    # however this run ends -- including the fail-loud exits below.
    # shellcheck disable=SC2064  # expand root/starting_branch now, not at exit
    trap "restore_branch '$root' '$starting_branch'" EXIT

    # Both arrays can legitimately be empty here (an adoption-only sync copies
    # nothing), and `"${empty[@]}"` is an unbound-variable error under `set -u`
    # in bash 3.2, which is what macOS ships. Guard on the length instead.
    local -a changed_destinations=()
    if ((${#changed[@]} > 0)); then
        for pair in "${changed[@]}"; do
            destination="$(managed_destination "$pair")"
            changed_destinations+=("$destination")
            mkdir -p "$(dirname -- "$root/$destination")"
            cp "$KIT_DIR/$(managed_source "$pair")" "$root/$destination"
            mirror_exec_bit "$KIT_DIR/$(managed_source "$pair")" "$root/$destination"
            record_adoption "$root" "$destination"
            if ((${#operator_adopted[@]} > 0)) && contains "$destination" "${operator_adopted[@]}"; then
                printf 'adopted at operator request (overwrote this repo'"'"'s copy): %s\n' "$destination"
            else
                printf 'updated %s\n' "$destination"
            fi
        done
    fi
    # Byte-identical files are not copied -- there is nothing to copy -- but the
    # permission they just granted still has to be written down.
    if ((${#auto_adopted[@]} > 0)); then
        for destination in "${auto_adopted[@]}"; do
            record_adoption "$root" "$destination"
        done
    fi
    chmod +x "$root/$HOOK_DESTINATION"
    # The record travels with the sync PR so the next run in a fresh clone sees
    # the same adoptions this one did -- but only claim it as an updated file
    # when its bytes actually moved. Listing an unchanged file in the PR body is
    # the same species of dishonesty as a check that passes without running.
    stage_manifest "$root"
    if manifest_is_dirty "$root"; then
        changed_destinations+=("$ADOPTION_MANIFEST")
    fi
    ((${#changed_destinations[@]} > 0)) ||
        fail "nothing to commit after staging; this is a bug in sync-policy -- report the run and re-check $root by hand"

    local version
    local message='chore: sync workflow-kit managed files'
    local title="$message"
    version="$(policy_version)"
    [[ -z "$version" ]] || title="$message (policy v$version)"

    local body="Propagates the current workflow-kit files into this repository."$'\n\n'"Updated files:"$'\n'
    for destination in "${changed_destinations[@]}"; do
        # Operator adoptions get their own heading below. Listing them here too
        # would file an overwrite of a repo-authored file under the same label
        # as a routine template bump -- which is exactly the misreading the
        # adoption guard exists to prevent.
        if ((${#operator_adopted[@]} > 0)) && contains "$destination" "${operator_adopted[@]}"; then
            continue
        fi
        body+="- \`$destination\`"$'\n'
    done
    if ((${#operator_adopted[@]} > 0)); then
        body+=$'\nAdopted at operator request (verified kit lineage, overwritten with kit version)\n-- these differed from the kit and were NOT recorded as kit-owned. The operator\npassed `--adopt` to attest, from this repo\'s Git history, that the difference was\nkit staleness rather than project content. Review these lines with that in mind:\n'
        for destination in "${operator_adopted[@]}"; do
            body+="- \`$destination\`"$'\n'
        done
    fi
    if ((${#auto_adopted[@]} > 0)); then
        body+=$'\nNewly recorded as kit-owned -- these were already byte-identical to the kit, so\nadopting them changed nothing; future kit updates may now overwrite them:\n'
        for destination in "${auto_adopted[@]}"; do
            body+="- \`$destination\`"$'\n'
        done
    fi
    if ((${#skipped[@]} > 0)); then
        body+=$'\nNot synced -- these carry the `kit-sync: project-owned` marker:\n'
        for destination in "${skipped[@]}"; do
            body+="- \`$destination\`"$'\n'
        done
    fi
    body+=$'\nOpened by `project-workflow sync-policy`. Only files the kit owns byte-for-byte\nare touched; CLAUDE.md and the justfile are project-owned and were not changed.\n'

    git -C "$root" add -- "${changed_destinations[@]}" || fail "git add failed in $root"
    git -C "$root" commit --quiet -m "$message" || fail "git commit failed in $root"
    git -C "$root" push --quiet -u origin "$SYNC_BRANCH" || fail "git push failed for $SYNC_BRANCH"
    local pr_url
    pr_url="$(gh_in_repo "$root" pr create --base dev --head "$SYNC_BRANCH" --title "$title" --body "$body")" ||
        fail "gh pr create failed for $SYNC_BRANCH"
    printf '\nopened %s\nReview and merge it yourself; sync-policy never merges.\n' "$pr_url"
}

gh_setup() {
    local directory=""
    local repository=""
    local apply=false
    while (($#)); do
        case "$1" in
            --dir) directory="${2:-}"; shift 2 ;;
            --repo) repository="${2:-}"; shift 2 ;;
            --apply) apply=true; shift ;;
            *) fail "unknown gh-setup argument: $1" ;;
        esac
    done
    [[ -n "$directory" ]] || fail "gh-setup requires --dir PATH"
    require_command git
    require_command gh
    local root
    root="$(project_root "$directory")"
    if [[ -z "$repository" ]]; then
        repository="$(gh_in_repo "$root" repo view --json nameWithOwner --jq .nameWithOwner)"
    fi
    gh auth status >/dev/null || fail "GitHub CLI is not authenticated"
    if [[ "$apply" == false ]]; then
        cat <<EOF
Review and then run:
  project-workflow gh-setup --dir $root --repo $repository --apply

This creates the task labels and opts the repo into the strict main ruleset by
setting the '$WORKFLOW_PROPERTY' custom property to true.

Branch rules themselves are NOT set here. They live once, at the org level, and
already cover every repo including ones that do not exist yet:
  baseline-history-protection  all repos, main/master/dev: no force-push, no delete
  agent-workflow-main-strict   opted-in repos, main: PR + green Deep integration checks
dev deliberately has NO required checks, so direct pushes to it keep working;
the local .githooks/pre-push gate is what guards that path. See rulesets/README.md.
EOF
        return
    fi
    gh label create task --color 0E8A16 --description 'Agent-owned implementation task' --force -R "$repository"
    gh label create handoff --color 5319E7 --description 'Needs another session to continue' --force -R "$repository"
    gh label create blocked --color B60205 --description 'Blocked on an external decision or state' --force -R "$repository"
    gh label create fast-lane --color FBCA04 --description 'Pre-triaged mechanical issue; eligible for batching 2-4 per PR' --force -R "$repository"

    # Opting in is a single property flip. This is the whole per-repo protection
    # step now -- the rules are already defined org-wide and match on this value.
    # -f (not -F) on the value: the property is value_type=true_false, whose
    # wire representation is the STRING "true". -F coerces true to a JSON
    # boolean and the API rejects it with 422 "Data type must be one of:
    # string, array".
    gh api --method PATCH "orgs/$ORG/properties/values" \
        -f "repository_names[]=${repository#*/}" \
        -f "properties[][property_name]=$WORKFLOW_PROPERTY" \
        -f 'properties[][value]=true'

    # A ruleset that returned 201 is not a ruleset that applies. Show what
    # GitHub says is actually in force on main, so a targeting mistake surfaces
    # here rather than as an unmergeable PR weeks later.
    printf '\nRules now in force on main for %s:\n' "$repository"
    gh ruleset check main --repo "$repository" || true
    printf '\nConfigured labels for %s and opted it into %s.\n' "$repository" "$WORKFLOW_PROPERTY"
}

main() {
    [[ $# -gt 0 ]] || { usage; exit 1; }
    local command="$1"
    shift
    case "$command" in
        init) init "$@" ;;
        check) check "$@" ;;
        sync-policy) sync_policy "$@" ;;
        gh-setup) gh_setup "$@" ;;
        -h|--help|help) usage ;;
        *) fail "unknown command: $command" ;;
    esac
}

main "$@"
