{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "USE_BUILTIN_RIPGREP": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Bash(git push)",
      "Bash(git push:*)",
      "WebFetch",
      "WebSearch",
      "Skill(arewedone)",
      "Skill(db-search)",
      "Skill(design-principles)",
      "Skill(frontend-design)",
      "Skill(person-profiler)",
      "Skill(log-to-daily)",
      "Skill(media-manager)",
      "Skill(request)",
      "Skill(dotfiles-tweaker)",
      "mcp__context7__get-library-docs",
      "mcp__context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "ExitPlanMode",
      "Read(//home/vmasrani/**)",
      "Edit(//home/vmasrani/**)",
      "Read(//data/**)",
      "Edit(//data/**)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run rerun:*)"
    ],
    "deny": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/vmasrani",
      "/data"
    ]
  },
  "model": "fable[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/.claude/hooks/bash_footgun_guard.py"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/.claude/hooks/unqueued_heavy_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/post_tool_use.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/.claude/hooks/test_count_guard.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_compact.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zsh ~/.claude/hooks/canary_check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "zsh ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": false,
    "frontend@mag-claude-plugins": false,
    "code-analysis@mag-claude-plugins": false,
    "orchestration@mag-claude-plugins": false,
    "pyright-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "ralph-wiggum@claude-plugins-official": false,
    "ralph-wiggum@claude-code-plugins": false,
    "commit-commands@claude-plugins-official": false,
    "claude-mem@thedotmack": false,
    "skill-creator@claude-plugins-official": true,
    "telegram@claude-plugins-official": false,
    "cloudflare@cloudflare": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "/home/vmasrani",
        "/data"
      ]
    }
  },
  "effortLevel": "high",
  "autoCompactWindow": 1000000,
  "showClearContextOnPlanAccept": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "iterm2",
  "teammateMode": "tmux",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "The user's development directory is ~/dev (/home/vmasrani/dev). Large datasets live on a separate disk mounted at /data, symlinked as ~/dev/data (so the same file appears as both /home/vmasrani/dev/data/... and /data/...). Treat everything under /data as the user's own project files -- equivalent to paths under the home directory, not untrusted, removable, or system locations."
    ]
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754286002006
  }
}
